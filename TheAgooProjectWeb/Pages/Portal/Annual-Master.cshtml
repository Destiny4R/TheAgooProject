@page
@model TheAgooProjectWeb.Pages.Portal.AnnualMasterModel
@{
    ViewData["Title"] = "Class Annual Master Result";
    ViewData["SubTitle"] = "View and export the annual master sheet";
    int sn = 0;

    // Column count used for colspan calculations.
    // Fixed = 3 (S/N, Full Name, Sex) + summary = 6 (Annual Total, Avg, Pos, Grade, Remark, Action)
    // Dynamic per subject = 3 term columns each.
    int subjectColspan = Model.Subjects.Count * 3;
    int summaryColspan = 6;

    string scoreStyle(double v) =>
        v == 0
            ? "background:#fafafa;color:#bbb;"
            : (v >= 70 ? "background:#c8e6c9;color:#1b5e20;"
            : (v >= 50 ? "background:#fff9c4;color:#f57f17;"
            : "background:#ffcdd2;color:#b71c1c;"));

    string gradeStyle(string g) => g switch
    {
        "A" => "background:#1b5e20;color:#fff;",
        "B" => "background:#2e7d32;color:#fff;",
        "C" => "background:#f9a825;color:#fff;",
        "D" => "background:#ef6c00;color:#fff;",
        "E" => "background:#c62828;color:#fff;",
        _ => "background:#6c757d;color:#fff;"
    };
}
@section Sheets {
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-bar-chart-line me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <a class="btn btn-light btn-sm tms-back" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
    </div>

    <!-- Filter Form -->
    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">
                            <i class="bi bi-calendar3 me-1" style="color:#3949ab"></i>Session / Year
                        </label>
                        <select asp-for="CTSSClass.SessionYear" class="form-select form-select-sm" asp-items="Model.ViewSelectModel.SessionYearz">
                            <option value="" disabled selected>— Select Session —</option>
                        </select>
                        <span asp-validation-for="CTSSClass.SessionYear" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">
                            <i class="bi bi-mortarboard me-1" style="color:#3949ab"></i>Class
                        </label>
                        <select asp-for="CTSSClass.Classes" class="form-select form-select-sm" asp-items="Model.ViewSelectModel.Class">
                            <option value="" disabled selected>— Select Class —</option>
                        </select>
                        <span asp-validation-for="CTSSClass.Classes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">
                            <i class="bi bi-people me-1" style="color:#3949ab"></i>Sub-Class
                        </label>
                        <select asp-for="CTSSClass.Subclass" class="form-select form-select-sm" asp-items="Model.ViewSelectModel.SubClass">
                            <option value="" disabled selected>— Sub-Class —</option>
                        </select>
                        <span asp-validation-for="CTSSClass.Subclass" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm w-100" type="submit" style="background:#283593;color:#fff;font-weight:600;padding:.42rem;">
                            <i class="bi bi-search me-1"></i> Generate
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.StudentRows.Any())
    {
        <!-- Session / class info strip -->
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 p-2 rounded" style="background:#e8eaf6;border:1px solid #c5cae9;">
            <span class="small text-muted">
                <i class="bi bi-info-circle me-1"></i>Showing results for:
            </span>
            <span class="badge" style="background:#283593;color:#fff;">@Model.BannerSession</span>
            <span class="badge" style="background:#283593;color:#fff;">@Model.BannerClass — @Model.BannerSubClass</span>
            <span class="badge" style="background:#3949ab;color:#fff;">@Model.BannerTerms</span>
            <span class="ms-auto" style="font-size:.78rem;color:#555;">
                <i class="bi bi-people me-1"></i>@Model.StudentCount student(s) &nbsp;|&nbsp;
                <i class="bi bi-book me-1"></i>@Model.SubjectCount subject(s) &nbsp;|&nbsp;
                <i class="bi bi-calendar-range me-1"></i>@Model.ActiveTermCount term(s)
            </span>
        </div>

        <!-- Toolbar -->
        <div class="d-flex flex-wrap gap-2 my-3">
            <button id="btnExcel" class="btn btn-sm btn-success" title="Export to Excel">
                <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
            </button>
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary" title="Print">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>

        <!-- Master sheet table -->
        <div class="table-responsive">
            <table id="masterSheetTable" class="table table-bordered table-sm" style="font-size:.8rem;width:100%;">
                <thead>
                    <!-- Row 1: Subject group headers + annual summary columns -->
                    <tr>
                        <th rowspan="3" class="text-center" style="min-width:35px;vertical-align:middle;background:#e8eaf6;">S/N</th>
                        <th rowspan="3" style="min-width:150px;vertical-align:middle;background:#e8eaf6;">Full Name</th>
                        <th rowspan="3" class="text-center" style="min-width:55px;vertical-align:middle;background:#e8eaf6;">Sex</th>

                        @foreach (var sub in Model.Subjects)
                        {
                            <th colspan="3" class="text-center" style="background:#c5cae9;color:#1a237e;font-size:.72rem;">@sub.SubjectName.ToUpper()</th>
                        }

                        <th rowspan="3" class="text-center" style="min-width:70px;vertical-align:middle;background:#283593;color:#fff;">ANNUAL<br/>TOTAL</th>
                        <th rowspan="3" class="text-center" style="min-width:60px;vertical-align:middle;background:#283593;color:#fff;">ANNUAL<br/>AVERAGE</th>
                        <th rowspan="3" class="text-center" style="min-width:60px;vertical-align:middle;background:#283593;color:#fff;">ANNUAL<br/>POSITION</th>
                        <th rowspan="3" class="text-center" style="min-width:45px;vertical-align:middle;background:#283593;color:#fff;">GRADE</th>
                        <th rowspan="3" class="text-center" style="min-width:75px;vertical-align:middle;background:#283593;color:#fff;">REMARK</th>
                        <th rowspan="3" class="text-center" style="min-width:70px;vertical-align:middle;background:#283593;color:#fff;">ACTION</th>
                    </tr>

                    <!-- Row 2: Period group label -->
                    <tr>
                        @foreach (var sub in Model.Subjects)
                        {
                            <th colspan="3" class="text-center" style="font-size:.66rem;color:#3949ab;background:#f5f5f5;">PERIOD</th>
                        }
                    </tr>

                    <!-- Row 3: Term columns -->
                    <tr>
                        @foreach (var sub in Model.Subjects)
                        {
                            <th class="text-center" style="min-width:40px;background:#e8eaf6;font-size:.68rem;">1<sup>st</sup></th>
                            <th class="text-center" style="min-width:40px;background:#e8eaf6;font-size:.68rem;">2<sup>nd</sup></th>
                            <th class="text-center" style="min-width:40px;background:#e8eaf6;font-size:.68rem;">3<sup>rd</sup></th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @{
                        sn = 0;
                    }
                    @foreach (var row in Model.StudentRows)
                    {
                        sn++;
                        string rowClass = sn % 2 == 0 ? "bg-light" : "";
                        <tr class="@rowClass">
                            <td class="text-center"><strong>@sn</strong></td>
                            <td style="text-align:left;font-weight:600;">
                                @row.FullName
                                <br />
                                <span class="badge bg-warning">@row.AdmissionNo</span>
                            </td>
                            <td class="text-center">@row.Gender</td>

                            @foreach (var sub in Model.Subjects)
                            {
                                if (row.SubjectTotals.TryGetValue(sub.SubjectId, out var st) && st != null)
                                {
                                    <td class="text-center" style="@scoreStyle(st.First)">@st.First</td>
                                    <td class="text-center" style="@scoreStyle(st.Second)">@st.Second</td>
                                    <td class="text-center" style="@scoreStyle(st.Third)">@st.Third</td>
                                }
                                else
                                {
                                    <td class="text-center" style="background:#fafafa;color:#bbb;">—</td>
                                    <td class="text-center" style="background:#fafafa;color:#bbb;">—</td>
                                    <td class="text-center" style="background:#fafafa;color:#bbb;">—</td>
                                }
                            }

                            <td class="text-center" style="font-weight:700;color:#1a237e;">@row.AnnualTotal</td>
                            <td class="text-center" style="font-weight:700;color:#1a237e;">@row.AnnualAverage</td>
                            <td class="text-center">
                                @if (row.Position > 0)
                                {
                                    @row.Position<sup>@SD.specialNumber(row.Position)</sup>
                                }
                                else
                                {
                                    <span style="color:#bbb;">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge" style="@gradeStyle(row.Grade)">@row.Grade</span>
                            </td>
                            <td style="text-align:left;font-size:.71rem;">@row.Remark</td>
                            <td class="text-center">
                                <a asp-page="Annual-Result"
                                   asp-route-studentid="@row.StudentId"
                                   asp-route-session="@Model.CTSSClass.SessionYear"
                                   class="btn btn-sm btn-outline-primary text-decoration-none" target="_blank"
                                   title="View @row.FullName's annual result">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

                <!-- Summary footer -->
                <tfoot>
                    <!-- Termly subject averages -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">
                            <i class="bi bi-bar-chart me-1"></i>Termly Subject Average →
                        </td>
                        @foreach (var s in Model.SubjectSummaries)
                        {
                            <td class="text-center">@s.FirstAverage</td>
                            <td class="text-center">@s.SecondAverage</td>
                            <td class="text-center">@s.ThirdAverage</td>
                        }
                        <td colspan="@summaryColspan"></td>
                    </tr>

                    <!-- Annual subject average -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">
                            <i class="bi bi-graph-up me-1"></i>Annual Subject Average →
                        </td>
                        @foreach (var s in Model.SubjectSummaries)
                        {
                            <td colspan="3" class="text-center fw-bold" style="color:#1a237e;">@s.AnnualAverage</td>
                        }
                        <td colspan="@summaryColspan"></td>
                    </tr>

                    <!-- Highest annual mark per subject -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">
                            <i class="bi bi-arrow-up me-1"></i>Highest Annual Mark in Class →
                        </td>
                        @foreach (var s in Model.SubjectSummaries)
                        {
                            <td colspan="3" class="text-center fw-bold" style="color:#1b5e20;">@s.Highest</td>
                        }
                        <td colspan="@summaryColspan"></td>
                    </tr>

                    <!-- Lowest annual mark per subject -->
                    <tr>
                        <td colspan="3" class="text-end fw-bold">
                            <i class="bi bi-arrow-down me-1"></i>Lowest Annual Mark in Class →
                        </td>
                        @foreach (var s in Model.SubjectSummaries)
                        {
                            <td colspan="3" class="text-center fw-bold" style="color:#880e4f;">@s.Lowest</td>
                        }
                        <td colspan="@summaryColspan"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Grade key legend -->
        <div class="mt-3 p-2 rounded" style="background:#f5f5f5;border:1px solid #e0e0e0;font-size:.78rem;color:#555;">
            <strong>Grade Key:</strong>
            &nbsp;<span class="badge" style="background:#1b5e20;color:#fff;">A</span> Excellent (75–100) &nbsp;
            <span class="badge" style="background:#2e7d32;color:#fff;">B</span> Very Good (65–74) &nbsp;
            <span class="badge" style="background:#f9a825;color:#fff;">C</span> Good (55–64) &nbsp;
            <span class="badge" style="background:#ef6c00;color:#fff;">D</span> Fair (40–54) &nbsp;
            <span class="badge" style="background:#c62828;color:#fff;">E</span> Poor (Below 40)
        </div>
    }
    else if (TempData["error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mt-3" role="alert">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@TempData["error"]</span>
        </div>
    }
    else
    {
        <div class="card mt-3">
            <div class="card-body text-center py-5">
                <i class="bi bi-bar-chart-line" style="font-size:3rem;color:#c5cae9;"></i>
                <h4 class="mt-2">No Data to Display</h4>
                <p class="text-muted mb-0">
                    Select a <strong>Session/Year</strong>, <strong>Class</strong> and <strong>Sub-Class</strong>
                    above, then click <em>Generate</em> to load the Class Annual Master Result.
                </p>
            </div>
        </div>
    }
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script>
        $(document).ready(function () {
            var table = $('#masterSheetTable').DataTable({
                paging: false,
                filter: false,
                info: false,
                responsive: false,
                lengthChange: false,
                dom: '<"d-flex justify-content-end mb-2"B>t',
                buttons: {
                    buttons: ['excel', 'pdf', 'print'],
                    title: null
                }
            });
            $('#btnExcel').on('click', function () {
                table.button('.buttons-excel').trigger();
            });
        });
    </script>
}
