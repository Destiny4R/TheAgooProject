@page
@model TheAgooProjectWeb.Pages.Portal.Terminal_Master_SheetModel
@{
    ViewData["Title"] = "Terminal Master Sheet";
    int sn = 0;
}
@section AddToHead{
    <link href="/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
}
<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge  badge-info bg-info text-uppercase"><strong class="h5">Terminal Master Sheet</strong></div>
                <a class="btn btn-dark btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
            </div>
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-2 mt-2" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <strong><i class="fas fa-exclamation-triangle"></i> </strong> @TempData["error"].
                </div>
            }
            <div class="row p-2">
                <div class="col-md-10">
                    <form method="post">
                        <div class="form-row align-items-center">
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Term</label>
                                    <select asp-for="CTSSClass.Term" class="form-control form-control-sm">
                                        <option value="" disabled selected>---Select Term---</option>
                                        <option value="First">First</option>
                                        <option value="Second">Second</option>
                                        <option value="Third">Third</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Session/Year</label>
                                    <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz" required>
                                        <option value="" disabled selected>---Select Session/Year---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Class</label>
                                    <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class" required>
                                        <option value="" disabled selected>---Select Class---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Sub Class</label>
                                    <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass" required>
                                        <option value="" disabled selected>---Select Sub-Class---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary mt-3"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @if (Model.Result?.Count() > 0)
        {
            <div class="card-body">
                <div class="mb-2 d-flex justify-content-end">
                    <button class="btn-success btn mt-2" type="button" id="getexcelbtn"><i class="far fa-file-excel"></i>&nbsp; Export excel</button>
                </div>
                <table class="table-bordered table table-responsive" id="terminalTable" width="100%">
                    <thead>
                        <tr class="table-primary">
                            <th colspan="3">@(Html.Raw(Model.information))</th>
                            @foreach (var item in Model.GetSubjects.OrderByDescending(q => q.SubjId))
                            {
                                <th rowspan="2" class="rotate-upward text-center">@item.Name</th>
                            }
                            <th rowspan="2" class="rotate-upward text-center">Total</th>
                            <th rowspan="2" class="rotate-upward text-center">Average</th>
                            <th rowspan="2" class="rotate-upward text-center">Position</th>
                            <th rowspan="2" class="rotate-upward text-center">Remark</th>
                        </tr>
                        <tr class="table-primary">
                            <th>#</th>
                            <th>Full Name</th>
                            <th>Sex</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Result.GroupBy(q => q.TermRegId))
                        {
                            sn++;
                            string name = item.FirstOrDefault().Termregistration.StudentsData.SurName + " "
                                + item.FirstOrDefault().Termregistration.StudentsData.OtherName + " "
                                + item.FirstOrDefault().Termregistration.StudentsData.FirstName;
                            <tr>
                                <td>@(sn)</td>
                                <td>@(name)</td>
                                <td>@(item.FirstOrDefault().Termregistration.StudentsData.Gender)</td>

                                @foreach (var subj in Model.GetSubjects.OrderByDescending(q => q.SubjId))
                                {
                                    var subject = item.Where(k => k.SubjectId == subj.SubjId).ToList();
                                    var firstSubject = subject.FirstOrDefault();
                                    if (firstSubject != null)
                                    {
                                        <td>@firstSubject.Total</td>
                                    }
                                    else
                                    {
                                        <td><label class="badge badge-info">Null</label></td>
                                    }
                                }


                                <td>@(Model.students.Where(q=>q.StudId==item.FirstOrDefault().TermRegId).FirstOrDefault().TotalScore)</td>
                                <td>
                                    @{ 
                                        var _Average = Math.Round(Model.students.Where(q => q.StudId == item.FirstOrDefault().TermRegId).FirstOrDefault().Average, 2);
                                    }
                                    @(_Average)
                                </td>
                                <td>
                                    @{
                                        var datax = Model.students.Where(q => q.StudId == item.FirstOrDefault().TermRegId).FirstOrDefault().Rank;
                                    }
                                    <strong>@datax<sup>@(SD.specialNumber(datax))</sup></strong>
                                </td>
                                <td>@(SD.GetRemark(Math.Round(_Average)))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <!-- Buttons examples -->
    <script src="/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
    <script src="/assets/libs/jszip/jszip.min.js"></script>
    <script src="/assets/libs/pdfmake/build/pdfmake.min.js"></script>
    <script src="/assets/libs/pdfmake/build/vfs_fonts.js"></script>
    <script src="/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
    <!-- Responsive examples -->
    <script src="/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
    <script src="~/js/jquery.table2excel.js"></script>
    <script>
        $(function () {
            $("#terminalTable").DataTable({
                lengthChange: !1,
                "filter": false,
                responsive: false,
                "info": false,
                "paging": false,
                buttons: ["copy", "excel", "pdf", "colvis"]
            }).buttons().container().appendTo("#terminalTable_wrapper .col-md-6:eq(0)")



            $("#terminalTable").find('#getexcelbtn').on('click', function () {
                $.print("#terminalTable");
            });
            $("#getexcelbtn").click(function (e) {
                $("#terminalTable").table2excel({
                    name: "Worksheet Name",
                    filename: 'Terminal_Report_Sheet',
                    fileext: ".xlsx",
                    preserveColors: true
                });
            });
        });
    </script>
}