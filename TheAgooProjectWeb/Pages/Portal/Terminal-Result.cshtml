@page
@inject IOptions<AppConfigurations> SchoolConfig
@model TheAgooProjectWeb.Pages.Portal.Terminal_ResultModel
@{
    Layout = null;
    string studentFullName = Model.Studentsdata != null
        ? $"{Model.Studentsdata.SurName} {Model.Studentsdata.OtherName} {Model.Studentsdata.FirstName}".Trim()
        : "Student";
    ViewData["title"] = studentFullName;

    string schoolName = $"{SchoolConfig.Value.SchoolName} {SchoolConfig.Value.Layout1}".Trim();
    int sn = 0;

    int age = Model.Studentsdata != null && Model.Studentsdata.DateOfBirth != default
        ? DateTime.Now.Year - Model.Studentsdata.DateOfBirth.Year
        : 0;

    string passportPath = "/image/avatar2.png";
    if (Model.Studentsdata != null)
    {
        if (!string.IsNullOrEmpty(Model.Studentsdata.Passport))
        {
            passportPath = Model.Studentsdata.Passport;
        }
        else
        {
            passportPath = string.Equals(Model.Studentsdata.Gender, "Female", StringComparison.OrdinalIgnoreCase)
                ? "/image/avata.jpg"
                : "/image/avatar2.png";
        }
    }
}
@functions {
    string GetRating(byte? val) => val.HasValue && val.Value > 0 ? val.Value.ToString() : "--";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["title"] || @schoolName</title>
    <link rel="shortcut icon" href="/appicons/favicon.ico">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #212529;
        }

        .action-bar {
            background: #ffffff;
            border-bottom: 1px solid #e3e6f0;
            padding: 12px 24px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .result-card {
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            margin: 20px auto;
            max-width: 1100px;
            padding: 25px;
        }

        .school-header-title {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0d6efd;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }

        .student-info-table th {
            background-color: #f8f9fa;
            font-size: 0.88rem;
            font-weight: 600;
            color: #495057;
            width: 15%;
        }

        .student-info-table td {
            font-size: 0.92rem;
            font-weight: 700;
            color: #000;
        }

        .assessment-table th {
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .assessment-table td {
            font-size: 0.88rem;
            vertical-align: middle;
        }

        .ratings-table th, .ratings-table td {
            font-size: 0.82rem;
            padding: 4px 8px;
        }

        .signature-img {
            max-height: 50px;
            object-fit: contain;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background-color: #ffffff !important;
                color: #000000 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .result-card {
                box-shadow: none !important;
                margin: 0 !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
            @@page {
                size: A4 portrait;
                margin: 8mm;
            }
        }
    </style>
</head>
<body>

    <!-- Screen Navigation Action Bar (Hidden during Print) -->
    <div class="action-bar no-print d-flex justify-content-between align-items-center">
        <div>
            <a asp-page="index" class="btn btn-outline-secondary btn-sm me-2" onclick="window.history.back()">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <span class="fw-bold text-dark fs-6">Terminal Continuous Assessment Dossier</span>
        </div>
        <div>
            <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Print / Save PDF
            </button>
        </div>
    </div>

    <!-- Main Result Container -->
    <div class="container-fluid">
        <div class="result-card watermark-container">
            <input type="hidden" id="schoolname" value="@(schoolName) " />
            <div class="watermark">@schoolName</div>

            <!-- School Header Section -->
            <table width="100%" class="mb-3">
                <tr>
                    <td width="15%" class="text-start">
                        <img class="rounded-circle shadow-sm" src="@(SchoolConfig.Value.Logo)" width="110" height="110" alt="School Logo" />
                    </td>
                    <td width="70%" class="text-center">
                        <div class="getfont">
                            <h2 class="school-header-title">@schoolName</h2>
                            <p class="fw-semibold text-dark mb-1 h6" style=""><strong>@(SchoolConfig.Value.Address)</strong></p>
                            <p class="fw-semibold text-secondary mb-1" style="font-size: 0.95rem;">@(SchoolConfig.Value.StateAddress)</p>
                            <p class="mb-1" style="font-size: 0.88rem;"><strong>MOTTO:</strong> @(SchoolConfig.Value.Motto)</p>
                            <p class="mb-0" style="font-size: 0.85rem;">
                                <strong>EMAIL:</strong> @(SchoolConfig.Value.Email) &emsp; 
                                <strong>Tel:</strong> @(SchoolConfig.Value.Phone)
                            </p>
                        </div>
                    </td> 
                    <td width="15%" class="text-end">
                        <img class="rounded shadow-sm border" src="@(passportPath)" width="110" height="110" style="object-fit: cover;" alt="Student Photo" />
                    </td>
                </tr>
            </table>

            <!-- Student Metadata Table -->
            <table class="table-bordered border-primary student-info-table mb-3" width="100%">
                <tr>
                    <th>Student Name:</th>
                    <td class="getfontname">@(studentFullName)</td>
                    <th>Sex:</th>
                    <td class="getfontname">@(Model.Studentsdata?.Gender ?? "N/A")</td>
                    <th>Age:</th>
                    <td class="getfontname">@(age > 0 ? age.ToString() : "N/A")</td>
                </tr>
                <tr>
                    <th>Reg No.:</th>
                    <td class="getfontname">@(Model.Studentsdata?.StudentRegNo ?? "N/A")</td>
                    <th>Class:</th>
                    <td class="getfontname">@($"{Model._generalClass?.Classcchool?.Name} - {Model._generalClass?.SubClasses?.Name}")</td>
                    <th>Session/Year:</th>
                    <td class="getfontname">@(Model._generalClass?.SessionYear?.Name ?? "N/A")</td>
                </tr>
                <tr>
                    <th>No. In Class:</th>
                    <td class="getfontname">@(Model.NoInClass)</td>
                    <th>Attendance:</th>
                    <td class="getfontname">@(Model._remarkPosition != null ? Model._remarkPosition.Student_Attendance.ToString() : "0")</td>
                    <th>Days Opened:</th>
                    <td class="getfontname">@(Model._generalClass != null ? Model._generalClass.TotalAttendance.ToString() : "0")</td>
                </tr>
            </table>

            @if (Model.IsSenior)
            {
                <!-- SENIOR SECONDARY SCHOOL DOSSIER -->
                <table class=" table-bordered border-primary table-sm1 assessment-table1 mb-3" width="100%">
                    <tbody>
                        <tr>
                            <td colspan="14" class="bg-warning text-center fw-bold py-2 h6 mb-0">
                                TERMLY CONTINUOUS ASSESSMENT DOSSIER
                            </td>
                        </tr>
                        <tr class="text-center align-middle bg-light">
                            <td rowspan="2" class="py-3">@(Model._generalClass?.Term)&ensp;Term</td>
                            <td colspan="4" class="text-center">Summary of Cont. Assmt</td>
                            <td rowspan="3" class="rotate-upward">Terminal Exam</td>
                            <td rowspan="3" class="rotate-upward">Total Scores (100)</td>
                            <td rowspan="3" class="rotate-upward">Class Average</td>
                            <td rowspan="3" class="rotate-upward">Highest in Class</td>
                            <td rowspan="3" class="rotate-upward">Lowest in Class</td>
                            <td rowspan="3" class="rotate-upward">Position</td>
                            <td rowspan="3" class="rotate-upward">Grade</td>
                            <td rowspan="3" class="text-center align-middle">Remark</td>
                            <td rowspan="@(4 + Model.CollectDatas.Count)" width="18%" class="p-0 align-top">
                                <table class=" table-bordered border-warning text-center table-sm1 ratings-table1 mb-0" width="100%">
                                    <thead>
                                        <tr>
                                            <th colspan="2" class="bg-info text-dark text-center">Affective Development</th>
                                        </tr>
                                        <tr class="bg-light">
                                            <th>Traits</th>
                                            <th>Rating (1-5)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Attentiveness</td><td>@(GetRating(Model.termReg?.StudentRatings?.Attentiveness))</td></tr>
                                        <tr><td>Attendance</td><td>@(GetRating(Model.termReg?.StudentRatings?.Attendance))</td></tr>
                                        <tr><td>Reliability</td><td>@(GetRating(Model.termReg?.StudentRatings?.Reliability))</td></tr>
                                        <tr><td>Punctuality</td><td>@(GetRating(Model.termReg?.StudentRatings?.Punctuality))</td></tr>
                                        <tr><td>Perseverance</td><td>@(GetRating(Model.termReg?.StudentRatings?.Perseverance))</td></tr>
                                        <tr><td>Neatness</td><td>@(GetRating(Model.termReg?.StudentRatings?.Neatness))</td></tr>
                                        <tr><td>Responsibility</td><td>@(GetRating(Model.termReg?.StudentRatings?.Sense_of_Responsibility))</td></tr>
                                        <tr><td>Politeness</td><td>@(GetRating(Model.termReg?.StudentRatings?.Politeness))</td></tr>
                                        <tr><td>Cooperation</td><td>@(GetRating(Model.termReg?.StudentRatings?.Spirit_of_Cooperation))</td></tr>
                                        <tr><td>Self Control</td><td>@(GetRating(Model.termReg?.StudentRatings?.SelfControl))</td></tr>
                                        <tr><td>Rel. w/ Students</td><td>@(GetRating(Model.termReg?.StudentRatings?.Relationship_With_Student))</td></tr>
                                        <tr><td>Rel. w/ Staff</td><td>@(GetRating(Model.termReg?.StudentRatings?.Relation_With_Staff))</td></tr>
                                        <tr><td>Curiosity</td><td>@(GetRating(Model.termReg?.StudentRatings?.Curiosity))</td></tr>
                                        <tr><td>Initiative</td><td>@(GetRating(Model.termReg?.StudentRatings?.Initiative))</td></tr>
                                        <tr><td>Honesty</td><td>@(GetRating(Model.termReg?.StudentRatings?.Honesty))</td></tr>
                                        <tr><td>Industry</td><td>@(GetRating(Model.termReg?.StudentRatings?.Industry))</td></tr>
                                        <tr><td>Humility</td><td>@(GetRating(Model.termReg?.StudentRatings?.Humility))</td></tr>
                                        <tr><td>Organization</td><td>@(GetRating(Model.termReg?.StudentRatings?.Organisational_Ability))</td></tr>
                                        <tr><td>Tolerance</td><td>@(GetRating(Model.termReg?.StudentRatings?.Tolanrance))</td></tr>
                                        <tr><td>Leadership</td><td>@(GetRating(Model.termReg?.StudentRatings?.Leadership))</td></tr>
                                        <tr><td>Respect</td><td>@(GetRating(Model.termReg?.StudentRatings?.Respect_For_Other))</td></tr>
                                        <tr><td>Courage</td><td>@(GetRating(Model.termReg?.StudentRatings?.Courage))</td></tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr class="text-center align-middle bg-light">
                            <td class="rotate-upward">Assignment (5)</td>
                            <td class="rotate-upward">Class Work (5)</td>
                            <td class="rotate-upward">Project (10)</td>
                            <td class="rotate-upward">Test (10)</td>
                        </tr>
                        <tr class="text-center bg-primary text-white">
                            <td>Subject</td>
                            <td colspan="4">Formative Scores</td>
                        </tr>
                        @foreach (var item in Model.CollectDatas)
                        {
                            sn++;
                            <tr class="@(SD.colorful(sn)) text-center align-middle">
                                <td class="text-start fw-bold px-2">@(item.SujectName)</td>
                                <td>@(item.Assgmnt > 0 ? item.Assgmnt.ToString() : "--")</td>
                                <td>@(item.CWork > 0 ? item.CWork.ToString() : "--")</td>
                                <td>@(item.project > 0 ? item.project.ToString() : "--")</td>
                                <td>@(item.Test > 0 ? item.Test.ToString() : "--")</td>
                                <td>@(item.Exams > 0 ? item.Exams.ToString() : "--")</td>
                                <td><strong>@(item.TotalScores)</strong></td>
                                <td>@(item.Average)</td>
                                <td>@(item.Highest)</td>
                                <td>@(item.Lowest)</td>
                                <td>@(item.Position)<sup>@(SD.specialNumber(item.Position))</sup></td>
                                <td><strong>@(item.Grade)</strong></td>
                                <td>@(item.Remark)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Summary & Rating Tables for Senior -->
                <table width="100%" class="table-bordered border-primary mb-3">
                    <tr>
                        <td colspan="13" class="p-0">
                            <table width="100%" class=" table-bordered border-primary table-sm1 mb-0">
                                <tr>
                                    <td width="33%"><strong>No. Of Subjects:</strong> &emsp;@(Model.NoOfSubjects)</td>
                                    <td width="33%"><strong>Total Obtainable Marks:</strong> &emsp;@(Model.ObtainableMarks)</td>
                                    <td width="34%"><strong>Marks Obtained:</strong> &emsp;<strong>@(Model.TotalScoreObtained)</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Average:</strong> &emsp;<span class="text-primary fw-bold">@(Model.TerminalAverage)</span></td>
                                    <td><strong>Position In Class:</strong> &emsp;@(Model.Position)<sup>@(SD.specialNumber(Model.Position))</sup></td>
                                    <td><strong>Out of:</strong> &emsp;@(Model.NoInClass)</td>
                                </tr>
                                <tr>
                                    <th>Principal's Name:</th>
                                    <td colspan="2">@(Model._generalClass?.PrincipalName ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Class Teacher's Name:</th>
                                    <td colspan="2">@(Model._generalClass?.ClassTeacher ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Principal's Remarks:</th>
                                    <td colspan="2">@(Model.PrincipalRemark)</td>
                                </tr>
                                <tr>
                                    <th>Class Teacher's Remarks:</th>
                                    <td colspan="2">@(Model.TeacherRemark)</td>
                                </tr>
                                <tr>
                                    <th>Principal's Signature:</th>
                                    <td colspan="2">
                                        @if (!string.IsNullOrEmpty(Model.signature))
                                        {
                                            <img class="signature-img" src="@(Model.signature)" alt="Principal Signature" />
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Signed</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td width="30%" class="p-0 align-top">
                            <table class=" table-bordered border-warning table-sm1 ratings-table1 mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-info text-dark text-center fw-bold">Psychomotor Skills</th></tr>
                                    <tr class="bg-light"><th>Skills</th><th class="text-center">Rating</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Handwriting</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Handwriting))</td></tr>
                                    <tr><td>Fluency</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Fluecy))</td></tr>
                                    <tr><td>Drawing/Painting</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Drawing_Painting))</td></tr>
                                    <tr><td>Games/Sport</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Games_Sport))</td></tr>
                                    <tr><td>W/Shop Tools</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Handing_WShop_Tool))</td></tr>
                                    <tr><td>Musical Skills</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Musical_Skill))</td></tr>
                                    <tr><td>Construction</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Constrution))</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td width="25%" class="p-0 align-top">
                            <table class="table table-bordered border-warning table-sm ratings-table mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-info text-dark text-center fw-bold">KEYS TO RATING</th></tr>
                                </thead>
                                <tbody>
                                    <tr><th class="text-center">5</th><td>Excellent</td></tr>
                                    <tr><th class="text-center">4</th><td>Very Good</td></tr>
                                    <tr><th class="text-center">3</th><td>Good</td></tr>
                                    <tr><th class="text-center">2</th><td>Fair</td></tr>
                                    <tr><th class="text-center">1</th><td>Poor</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td width="45%" class="p-0 align-top">
                            <table class="table table-bordered border-warning table-sm ratings-table mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-info text-dark text-center fw-bold">NEXT TERM INFORMATION</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Next Term Fees</th>
                                        <td><strong>@(SD.ToNaira(Model._generalClass?.Next_Term_Fees ?? 0))</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Next Term Start</th>
                                        <td>@(Model._generalClass?.NextTermStart != default ? Model._generalClass.NextTermStart.ToShortDateString() : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th>Term End</th>
                                        <td>@(Model._generalClass?.TermEnd != default ? Model._generalClass.TermEnd.ToShortDateString() : "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            }
            else
            {
                <!-- JUNIOR SECONDARY SCHOOL DOSSIER -->
                <table class="table table-bordered border-primary table-sm assessment-table mb-3" width="100%">
                    <tbody>
                        <tr>
                            <td colspan="14" class="bg-primary text-white text-center fw-bold py-2 h6 mb-0">
                                TERMLY CONTINUOUS ASSESSMENT DOSSIER
                            </td>
                        </tr>
                        <tr class="text-center align-middle bg-light">
                            <td rowspan="2" class="py-3">@(Model._generalClass?.Term)&ensp;Term</td>
                            <td colspan="4" class="text-center">Summary of Continuous Assessment</td>
                            <td rowspan="3" class="rotate-upward">Terminal Exams (60)</td>
                            <td rowspan="3" class="rotate-upward">Total Scores (100)</td>
                            <td rowspan="3" class="rotate-upward">Class Average</td>
                            <td rowspan="3" class="rotate-upward">Highest in Class</td>
                            <td rowspan="3" class="rotate-upward">Lowest in Class</td>
                            <td rowspan="3" class="rotate-upward">Position</td>
                            <td rowspan="3" class="rotate-upward">Grade</td>
                            <td rowspan="3" class="text-center align-middle">Remark</td>
                            <td rowspan="@(4 + Model.CollectDatas.Count)" width="18%" class="p-0 align-top">
                                <table class="table table-bordered border-warning text-center table-sm ratings-table mb-0" width="100%">
                                    <thead>
                                        <tr>
                                            <th colspan="2" class="bg-success text-white text-center">Affective Development</th>
                                        </tr>
                                        <tr class="bg-light">
                                            <th>Traits</th>
                                            <th>Rating (1-5)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Attentiveness</td><td>@(GetRating(Model.termReg?.StudentRatings?.Attentiveness))</td></tr>
                                        <tr><td>Attendance</td><td>@(GetRating(Model.termReg?.StudentRatings?.Attendance))</td></tr>
                                        <tr><td>Punctuality</td><td>@(GetRating(Model.termReg?.StudentRatings?.Punctuality))</td></tr>
                                        <tr><td>Neatness</td><td>@(GetRating(Model.termReg?.StudentRatings?.Neatness))</td></tr>
                                        <tr><td>Self Control</td><td>@(GetRating(Model.termReg?.StudentRatings?.SelfControl))</td></tr>
                                        <tr><td>Rel. w/ Students</td><td>@(GetRating(Model.termReg?.StudentRatings?.Relationship_With_Student))</td></tr>
                                        <tr><td>Curiosity</td><td>@(GetRating(Model.termReg?.StudentRatings?.Curiosity))</td></tr>
                                        <tr><td>Honesty</td><td>@(GetRating(Model.termReg?.StudentRatings?.Honesty))</td></tr>
                                        <tr><td>Humility</td><td>@(GetRating(Model.termReg?.StudentRatings?.Humility))</td></tr>
                                        <tr><td>Tolerance</td><td>@(GetRating(Model.termReg?.StudentRatings?.Tolanrance))</td></tr>
                                        <tr><td>Leadership</td><td>@(GetRating(Model.termReg?.StudentRatings?.Leadership))</td></tr>
                                        <tr><td>Courage</td><td>@(GetRating(Model.termReg?.StudentRatings?.Courage))</td></tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr class="text-center align-middle bg-light">
                            <td class="rotate-upward">Assignment (10)</td>
                            <td class="rotate-upward">Class Work (10)</td>
                            <td class="rotate-upward">Project (10)</td>
                            <td class="rotate-upward">Test (10)</td>
                        </tr>
                        <tr class="text-center bg-secondary text-white">
                            <td>Subject</td>
                            <td colspan="4">Formative Scores</td>
                        </tr>
                        @foreach (var item in Model.CollectDatas)
                        {
                            sn++;
                            <tr class="@(SD.colorful(sn)) text-center align-middle">
                                <td class="text-start fw-bold px-2">@(item.SujectName)</td>
                                <td>@(item.Assgmnt > 0 ? item.Assgmnt.ToString() : "--")</td>
                                <td>@(item.CWork > 0 ? item.CWork.ToString() : "--")</td>
                                <td>@(item.project > 0 ? item.project.ToString() : "--")</td>
                                <td>@(item.Test > 0 ? item.Test.ToString() : "--")</td>
                                <td>@(item.Exams > 0 ? item.Exams.ToString() : "--")</td>
                                <td><strong>@(item.TotalScores)</strong></td>
                                <td>@(item.Average)</td>
                                <td>@(item.Highest)</td>
                                <td>@(item.Lowest)</td>
                                <td>@(item.Position)<sup>@(SD.specialNumber(item.Position))</sup></td>
                                <td><strong>@(item.Grade)</strong></td>
                                <td>@(item.Remark)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Summary & Rating Tables for Junior -->
                <table width="100%" class="table-bordered border-primary mb-3">
                    <tr>
                        <td colspan="13" class="p-0">
                            <table width="100%" class="table table-bordered border-primary table-sm mb-0">
                                <tr>
                                    <td width="33%"><strong>No. Of Subjects:</strong> &emsp;@(Model.NoOfSubjects)</td>
                                    <td width="33%"><strong>Total Obtainable Marks:</strong> &emsp;@(Model.ObtainableMarks)</td>
                                    <td width="34%"><strong>Marks Obtained:</strong> &emsp;<strong>@(Model.TotalScoreObtained)</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Average:</strong> &emsp;<span class="text-primary fw-bold">@(Model.TerminalAverage)</span></td>
                                    <td><strong>Position In Class:</strong> &emsp;@(Model.Position)<sup>@(SD.specialNumber(Model.Position))</sup></td>
                                    <td><strong>Out of:</strong> &emsp;@(Model.NoInClass)</td>
                                </tr>
                                <tr>
                                    <th>Principal's Name:</th>
                                    <td colspan="2">@(Model._generalClass?.PrincipalName ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Class Teacher's Name:</th>
                                    <td colspan="2">@(Model._generalClass?.ClassTeacher ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Principal's Remarks:</th>
                                    <td colspan="2">@(Model.PrincipalRemark)</td>
                                </tr>
                                <tr>
                                    <th>Class Teacher's Remarks:</th>
                                    <td colspan="2">@(Model.TeacherRemark)</td>
                                </tr>
                                <tr>
                                    <th>Principal's Signature:</th>
                                    <td colspan="2">
                                        @if (!string.IsNullOrEmpty(Model.signature))
                                        {
                                            <img class="signature-img" src="@(Model.signature)" alt="Principal Signature" />
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Signed</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td width="30%" class="p-0 align-top">
                            <table class="table table-bordered border-warning table-sm ratings-table mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-success text-white text-center fw-bold">Psychomotor Skills</th></tr>
                                    <tr class="bg-light"><th>Skills</th><th class="text-center">Rating</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Handwriting</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Handwriting))</td></tr>
                                    <tr><td>Fluency</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Fluecy))</td></tr>
                                    <tr><td>Games/Sport</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Games_Sport))</td></tr>
                                    <tr><td>Construction</td><td class="text-center">@(GetRating(Model.termReg?.StudentRatings?.Constrution))</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td width="25%" class="p-0 align-top">
                            <table class="table table-bordered border-warning table-sm ratings-table mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-success text-white text-center fw-bold">KEYS TO RATING</th></tr>
                                </thead>
                                <tbody>
                                    <tr><th class="text-center">5</th><td>Excellent</td></tr>
                                    <tr><th class="text-center">4</th><td>Very Good</td></tr>
                                    <tr><th class="text-center">3</th><td>Good</td></tr>
                                    <tr><th class="text-center">2</th><td>Fair</td></tr>
                                    <tr><th class="text-center">1</th><td>Poor</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td width="45%" class="p-0 align-top">
                            <table class="table table-bordered border-warning table-sm ratings-table mb-0" width="100%">
                                <thead>
                                    <tr><th colspan="2" class="bg-success text-white text-center fw-bold">NEXT TERM INFORMATION</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Next Term Fees</th>
                                        <td><strong>@(SD.ToNaira(Model._generalClass?.Next_Term_Fees ?? 0))</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Next Term Start</th>
                                        <td>@(Model._generalClass?.NextTermStart != default ? Model._generalClass.NextTermStart.ToShortDateString() : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th>Term End</th>
                                        <td>@(Model._generalClass?.TermEnd != default ? Model._generalClass.TermEnd.ToShortDateString() : "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            }

            <!-- Grading Key & Footer -->
            <div class="p-2 bg-light border rounded mb-2">
                <div class="fw-bold" style="font-size: 0.85rem;">KEY TO GRADING:</div>
                <div class="d-flex justify-content-between text-muted" style="font-size: 0.82rem;">
                    <span>75% & Above = A (Distinction) &bull; 65% - 74% = B (Very Good) &bull; 55% - 64% = C (Good) &bull; 40% - 54% = D (Fair) &bull; 39% & Below = E (Poor)</span>
                </div>
            </div>

            <div class="pt-2 text-center text-muted border-top d-flex justify-content-between align-items-center" style="font-size: 0.8rem;">
                <div><strong>Designed By: D-BEST RETURN TECH&copy;</strong></div>
                <div>
                    <a class="text-dark text-decoration-none" title="Contact Support" href="tel:08039410863">
                        <i class="bi bi-telephone-fill me-1"></i>08039410863
                    </a>
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/watermark.js"></script>
</body>
</html>
