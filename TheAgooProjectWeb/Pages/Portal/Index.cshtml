@page
@model TheAgooProjectWeb.Pages.Portal.IndexModel
@{
    ViewData["Title"] = "Portal Page";
    ViewData["SubTitle"] = "Print and download student result sheets";
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-print me-2"></i> Print Result
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Print and download student result sheets</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Print-Result" class="btn btn-outline-light btn-sm">Print Class Result</a>
            <a class="btn btn-outline-light btn-sm" asp-page="Terminal-Master-Sheet">Terminal Master Sheet</a>
            <a class="btn btn-outline-light btn-sm" asp-page="Annual-Master">Annual Master Sheet</a>
            <a class="btn btn-light btn-sm tms-back" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check2-all text-success"></i></strong> &emsp; @Html.Raw(TempData["success"]).
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle text-danger"></i></strong>&emsp; @Html.Raw(TempData["error"]).
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="row p-2">
                <div class="col-md-6">
                    <form method="post" asp-page-handler="PrintResult">
                        <div class="form-group mb-2">
                            <label for="username">Term</label>
                            <select asp-for="CTSSClass.Term" class="custom-select form-control form-control-sm">
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option>
                                <option value="Second">Second</option>
                                <option value="Third">Third</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Term" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="form-group mb-2">
                            <label for="useremail">Session/Year</label>
                            <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="form-group mb-2">
                            <label>Class</label>
                            <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Classes" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="form-group mb-2">
                            <label>Sub-Class</label>
                            <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="form-group mb-2">
                            <label>Student Reg. Number</label>
                            <input type="text" class="form-control" asp-for="StudentRegNo" />
                            <span asp-validation-for="CTSSClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-my-primary btn-block" style="background:#283593;color:#fff;font-weight:600;padding:.42rem;" type="submit">Print Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}