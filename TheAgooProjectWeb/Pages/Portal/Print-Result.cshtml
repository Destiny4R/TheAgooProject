@page
@model TheAgooProjectWeb.Pages.Portal.Print_ResultModel
@{
    ViewData["Title"] = "Print Class Result";
    int sn = 0;
}
<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge  badge-info bg-info text-uppercase"><strong class="h5">Terminal Bulk Result Printing</strong></div>
                <a class="btn btn-dark btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
            </div>
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-2 mt-2" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <strong><i class="fas fa-exclamation-triangle"></i> </strong> @TempData["error"].
                </div>
            }
            <div class="row p-2">
                <div class="col-md-10">
                    <form method="post">
                        <div class="form-row align-items-center">
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Term</label>
                                    <select asp-for="CTSSClass.Term" class="form-control form-control-sm">
                                        <option value="" disabled selected>---Select Term---</option>
                                        <option value="First">First</option>
                                        <option value="Second">Second</option>
                                        <option value="Third">Third</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Session/Year</label>
                                    <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz" required>
                                        <option value="" disabled selected>---Select Session/Year---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only">Class</label>
                                    <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class" required>
                                        <option value="" disabled selected>---Select Class---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="mt-3 mr-sm-2">
                                    <label class="sr-only" >Sub Class</label>
                                    <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass" required>
                                        <option value="" disabled selected>---Select Sub-Class---</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary mt-3"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @if (Model.TermReg?.Count() > 0)
        {
            <div class="card-body">
                <table class="table-bordered table table-responsive">
                    <thead class="text-center table-info">
                        <tr>
                            <th>#</th>
                            <th>FULL NAME</th>
                            <th>STUDENT REG. NO.</th>
                            <th>SESSION/YEAR</th>
                            <th>CLASS</th>
                            <th>SUB-CLASS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody class="table-bordered border-primary">
                        @foreach (var item in Model.TermReg)
                        {
                            sn++;
                            <tr>
                                <td>@(sn)</td>
                                <td>@(item.StudentsData.SurName + " " + item.StudentsData.OtherName + " " + item.StudentsData.FirstName)</td>
                                <td>@(item.StudentsData.StudentRegNo)</td>
                                <td>@(item.SessionYear.Name)</td>
                                <td>@(item.Schoolclasses.Name)</td>
                                <td>@(item.SubClasses.Name)</td>
                                <td>
                                    @if (item.Schoolclasses.Elective)
                                    {
                                        <a class="btn btn-sm btn-success" asp-page="Senior-Result-Sheet" asp-route-session="@(item.SessionYearId)" asp-route-classes="@(item.ClassesInSchoolId)" asp-route-term="@(item.Term)"
                                           asp-route-subclass="@(item.SubClassId)" asp-route-studentid="@(item.StudentId)" target="_blank"><i class="fas fa-print"></i> Print</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-success" asp-page="Junior-Result-Sheet" asp-route-session="@(item.SessionYearId)" asp-route-classes="@(item.ClassesInSchoolId)" asp-route-term="@(item.Term)"
                                           asp-route-subclass="@(item.SubClassId)" asp-route-studentid="@(item.StudentId)" target="_blank"><i class="fas fa-print"></i> Print</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
