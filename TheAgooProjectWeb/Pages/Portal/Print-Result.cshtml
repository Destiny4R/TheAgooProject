@page
@model TheAgooProjectWeb.Pages.Portal.Print_ResultModel
@{
    ViewData["Title"] = "Print Class Result";
    ViewData["SubTitle"] = "Bulk print result sheets for students in a class";
    int sn = 0;
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-printer me-2"></i> Terminal Bulk Result Printing
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Bulk print result sheets for students in a class</div>
        </div>
        <a class="btn btn-light btn-sm tms-back" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
    </div>
    <div class="card">
        <div class="card-header">
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-2 mt-2" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <strong><i class="fas fa-exclamation-triangle"></i> </strong> @TempData["error"].
                </div>
            }
            <div class="row p-2">
                <div class="col-md-10">
                    <form method="post">
                        <div class="row">
                            <div class="col-md-3">
                                <select asp-for="CTSSClass.Term" class="form-select ">
                                    <option value="" disabled selected>---Select Term---</option>
                                    <option value="First">First</option>
                                    <option value="Second">Second</option>
                                    <option value="Third">Third</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz" required>
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class" required>
                                    <option value="" disabled selected>---Select Class---</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select asp-for="CTSSClass.Subclass" class="form-select" asp-items="Model.ViewSelectModel.SubClass" required>
                                    <option value="" disabled selected>---Select Sub-Class---</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn " style="background:#283593;color:#fff;font-weight:600;padding:.42rem;"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @if (Model.TermReg?.Count() > 0)
        {
            <div class="card-body">
                <table class="table-bordered table table-responsive">
                    <thead class="text-center table-info">
                        <tr>
                            <th>#</th>
                            <th>FULL NAME</th>
                            <th>STUDENT REG. NO.</th>
                            <th>SESSION/YEAR</th>
                            <th>CLASS</th>
                            <th>SUB-CLASS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody class="table-bordered border-primary">
                        @foreach (var item in Model.TermReg)
                        {
                            sn++;
                            <tr>
                                <td>@(sn)</td>
                                <td>@(item.StudentsData.SurName + " " + item.StudentsData.OtherName + " " + item.StudentsData.FirstName)</td>
                                <td>@(item.StudentsData.StudentRegNo)</td>
                                <td>@(item.SessionYear.Name)</td>
                                <td>@(item.Schoolclasses.Name)</td>
                                <td>@(item.SubClasses.Name)</td>
                                <td>
                                    <a class="btn btn-sm btn-success" asp-page="Terminal-Result" asp-route-termregid="@(item.Id)" asp-route-classes="@(item.ClassesInSchoolId)" asp-route-term="@(item.Term)"
                                       asp-route-subclass="@(item.SubClassId)" asp-route-studentid="@(item.StudentId)" target="_blank"><i class="fas fa-print"></i> Print</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
