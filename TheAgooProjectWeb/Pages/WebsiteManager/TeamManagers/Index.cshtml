@page
@inject IOptions<AppConfigurations> SchoolConfig
@model TheAgooProjectWeb.Pages.WebsiteManager.TeamManagers.IndexModel
@{
    ViewData["Title"] = "School Management";
    ViewData["SubTitle"] = "View and manage the school management team";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-people me-2"></i> School Management List
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">View and manage the school management team</div>
        </div>
        <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus-square me-1"></i> Add team</a>
    </div>
    <div class="card">
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"].
            </div>
        }
        <div class="card-body">
            <table class="table-bordered table-striped table" id="teammanager" width="100%">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Position</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Hierarchy</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<input type="hidden" id="baseUrl" value="@SchoolConfig.Value.BaseUrl" />
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/managementteam.js" asp-append-version="true"></script>
}