@page
@inject IOptions<AppConfigurations> SchoolConfig
@model TheAgooProjectWeb.Pages.WebsiteManager.WebNews.IndexModel
@{
    ViewData["Title"] = "School News List";
    ViewData["SubTitle"] = "View and manage school news articles";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-newspaper me-2"></i> School News History
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">View and manage school news articles</div>
        </div>
        <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus-square me-1"></i> Add News</a>
    </div>
    <div class="card">
        <div class="card-body">
            <table class="table-bordered table-striped table" id="newsdatatable" width="100%">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Reporter</th>
                        <th>Headline/Subject</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<input type="hidden" id="baseUrl" value="@SchoolConfig.Value.BaseUrl" />
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/newsUpsertFile.js" asp-append-version="true"></script>
}
