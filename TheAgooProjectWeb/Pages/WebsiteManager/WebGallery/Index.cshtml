@page
@inject IOptions<AppConfigurations> SchoolConfig
@model TheAgooProjectWeb.Pages.WebsiteManager.WebGallery.IndexModel
@{
    ViewData["Title"] = "School Photo Gallery";
    ViewData["SubTitle"] = "View and manage school photo galleries";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-images me-2"></i> School Photo History
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">View and manage school photo galleries</div>
        </div>
        <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus-square me-1"></i> Add Photos</a>
    </div>
    <div class="card">
        <div class="card-body">
            <table class="table-bordered table-striped table" id="galleryPhotos" width="100%">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Caption</th>
                        <th>Uploaded By</th>
                        <th>No. of Images</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<input type="hidden" id="baseUrl" value="@SchoolConfig.Value.BaseUrl" />
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/photogallerypost.js" asp-append-version="true"></script>
}
