@page
@model TheAgooProjectWeb.Pages.Account.Login1Model
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - SecureAuth</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --primary-color: #2563eb;
                --primary-dark: #1e40af;
                --accent-color: #f59e0b;
                --text-dark: #1f2937;
                --text-light: #6b7280;
                --bg-light: #f9fafb;
                --border-color: #e5e7eb;
            }

            body {
                font-family: 'Segoe UI', Trebuchet MS, sans-serif;
                background: var(--bg-light);
                color: var(--text-dark);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .login-container {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0;
                background: white;
                border-radius: 16px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
                overflow: hidden;
                max-width: 1000px;
                width: 100%;
                min-height: 600px;
            }

            /* Logo Panel - Hidden on Mobile */
            .logo-panel {
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                padding: 60px 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                align-items: center;
                color: white;
                position: relative;
                overflow: hidden;
            }

                .logo-panel::before {
                    content: '';
                    position: absolute;
                    top: -50%;
                    right: -50%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
                    border-radius: 50%;
                }

                .logo-panel::after {
                    content: '';
                    position: absolute;
                    bottom: -30%;
                    left: -30%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                }

            .logo-content {
                position: relative;
                z-index: 1;
                text-align: center;
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 20px;
            }

            .logo-icon {
                font-size: 64px;
                margin-bottom: 10px;
                animation: float 3s ease-in-out infinite;
            }

            @@keyframes float {
                0%, 100% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-15px);
                }
            }

            .logo-brand {
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -1px;
                margin-bottom: 10px;
            }

            .logo-tagline {
                font-size: 14px;
                opacity: 0.9;
                font-weight: 300;
                letter-spacing: 0.5px;
            }

            .features-list {
                position: relative;
                z-index: 1;
                display: flex;
                flex-direction: column;
                gap: 16px;
                margin-top: 40px;
            }

            .feature-item {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 14px;
                opacity: 0.95;
            }

            .feature-icon {
                position: relative;
                width: 28px;
                height: 28px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 6px;
                font-size: 16px;
                flex-shrink: 0;
            }

            /* Form Panel */
            .form-panel {
                padding: 60px 40px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                position: relative;
            }

            .form-header {
                margin-bottom: 40px;
            }

                .form-header h1 {
                    font-size: 28px;
                    font-weight: 700;
                    margin-bottom: 8px;
                    color: var(--text-dark);
                }

                .form-header p {
                    font-size: 14px;
                    color: var(--text-light);
                    margin: 0;
                }

            .form-group-custom {
                margin-bottom: 20px;
            }

                .form-group-custom label {
                    display: block;
                    font-weight: 600;
                    font-size: 13px;
                    margin-bottom: 8px;
                    color: var(--text-dark);
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

            .input-wrapper {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
            }

            .form-group-custom input {
                width: 100%;
                padding: 12px 40px 12px 40px;
                border: 2px solid var(--border-color);
                border-radius: 8px;
                font-size: 14px;
                transition: all 0.3s ease;
                background: white;
                color: var(--text-dark);
            }

                .form-group-custom input::placeholder {
                    color: var(--text-light);
                }

                .form-group-custom input:focus {
                    outline: none;
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
                }

            .input-icon {
                position: absolute;
                left: 12px;
                font-size: 18px;
                color: var(--primary-color);
                pointer-events: none;
                z-index: 2;
            }

            .password-toggle {
                position: absolute;
                right: 12px;
                font-size: 18px;
                color: var(--text-light);
                cursor: pointer;
                background: none;
                border: none;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
                z-index: 3;
            }

                .password-toggle:hover {
                    color: var(--primary-color);
                }

                .password-toggle:active {
                    transform: scale(0.95);
                }

            .form-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
                gap: 12px;
            }

            .form-check-custom {
                display: flex;
                align-items: center;
                gap: 6px;
                cursor: pointer;
            }

                .form-check-custom input[type="checkbox"] {
                    width: 16px;
                    height: 16px;
                    cursor: pointer;
                    accent-color: var(--primary-color);
                }

                .form-check-custom label {
                    margin: 0;
                    font-size: 13px;
                    color: var(--text-light);
                    cursor: pointer;
                    user-select: none;
                    font-weight: 400;
                }

            .forgot-password {
                color: var(--primary-color);
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .forgot-password:hover {
                    color: var(--primary-dark);
                    text-decoration: underline;
                }

            .btn-login {
                width: 100%;
                padding: 12px 24px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                color: white;
                border: none;
                border-radius: 8px;
                font-weight: 600;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                cursor: pointer;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
                margin-bottom: 20px;
            }

                .btn-login::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 100%;
                    height: 100%;
                    background: rgba(255, 255, 255, 0.2);
                    transition: left 0.3s ease;
                }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3);
                }

                    .btn-login:hover::before {
                        left: 100%;
                    }

            .divider {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 24px 0;
                color: var(--text-light);
                font-size: 13px;
            }

                .divider::before,
                .divider::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: var(--border-color);
                }

            .social-login {
                display: flex;
                gap: 12px;
            }

            .social-btn {
                flex: 1;
                padding: 10px;
                border: 2px solid var(--border-color);
                background: white;
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                color: var(--text-dark);
            }

                .social-btn:hover {
                    border-color: var(--primary-color);
                    background: var(--bg-light);
                    transform: translateY(-2px);
                }

            .signup-link {
                text-align: center;
                margin-top: 20px;
                font-size: 13px;
                color: var(--text-light);
            }

                .signup-link a {
                    color: var(--primary-color);
                    font-weight: 600;
                    text-decoration: none;
                    transition: color 0.3s ease;
                }

                    .signup-link a:hover {
                        color: var(--primary-dark);
                    }

            /* Responsive Design */
            @@media (max-width: 768px) {
                .login-container {
                    grid-template-columns: 1fr;
                    min-height: auto;
                }

                .logo-panel {
                    display: none;
                }

                .form-panel {
                    padding: 40px 24px;
                }

                .form-header h1 {
                    font-size: 24px;
                }

                .features-list {
                    flex-direction: row;
                    gap: 8px;
                    margin-top: 20px;
                }

                .feature-item {
                    font-size: 12px;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 16px;
                }

                .form-panel {
                    padding: 32px 20px;
                }

                .form-header {
                    margin-bottom: 28px;
                }

                    .form-header h1 {
                        font-size: 22px;
                    }

                    .form-header p {
                        font-size: 13px;
                    }

                .social-login {
                    gap: 10px;
                }

                .form-footer {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }

            /* Animation for form elements */
            .form-group-custom {
                animation: slideUp 0.5s ease backwards;
            }

                .form-group-custom:nth-child(1) {
                    animation-delay: 0.1s;
                }

                .form-group-custom:nth-child(2) {
                    animation-delay: 0.2s;
                }

            .form-footer {
                animation: slideUp 0.5s ease 0.3s backwards;
            }

            .btn-login {
                animation: slideUp 0.5s ease 0.4s backwards;
            }

            .divider {
                animation: slideUp 0.5s ease 0.5s backwards;
            }

            .social-login {
                animation: slideUp 0.5s ease 0.6s backwards;
            }

            .signup-link {
                animation: slideUp 0.5s ease 0.7s backwards;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Logo Panel - Hidden on Mobile -->
        <div class="logo-panel">
            <div class="logo-content">
                <div class="logo-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <div class="logo-brand">SecureAuth</div>
                <div class="logo-tagline">Enterprise Security</div>
            </div>

            <div class="features-list">
                <div class="feature-item">
                    <div class="feature-icon" style="position: relative;">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <span>256-bit Encryption</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon" style="position: relative;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <span>24/7 Protection</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon" style="position: relative;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <span>Real-time Monitoring</span>
                </div>
            </div>
        </div>

        <!-- Form Panel -->
        <div class="form-panel">
            <div class="form-header">
                <h1>Welcome Back</h1>
                <p>Sign in to your account to continue</p>
            </div>

            <form id="loginForm" method="post">
                <div class="form-group-custom">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <i class="bi bi-envelope input-icon" style="position: relative;"></i>
                        <input type="text"
                               asp-for="Username"
                               placeholder="you@example.com"
                               required>
                    </div>
                    <span asp-validation-for="Username" class="text-danger field-validation-valid badge badge-danger"></span>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right" style="position: relative; margin-right: 8px;"></i>
                    Sign In
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>