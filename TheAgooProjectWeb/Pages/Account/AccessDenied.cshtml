@page
@model TheAgooProjectWeb.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    ViewData["SubTitle"] = "You do not have permission to view this resource";
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-lock me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="bg-danger h5 text-white mb-3 mt-3">
            Sorry, you do not have permission to access this resource. Please contact your system administrator for more information..
        </div>
        <div>
            <img src="~/assets/images/accessdenied.jpg" width="100%" />
        </div>
    </div>
</div>