@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="page-content bg-primary bg-pattern">
    <div class="account-pages my-3 pt-3">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="mt-1 text-center">
                        <div>
                            <img src="/assets/images/error-img.png" alt="" class="img-fluid mx-auto d-block">
                        </div>

                        <h1 class="mt-2 text-uppercase text-danger font-weight-bold mb-3">Internal Server Error: 500</h1>
                        <h5 class="text-white text-uppercase">If the error continue, contact system engineer</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>