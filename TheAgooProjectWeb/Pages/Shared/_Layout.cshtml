@inject IOptions<AppConfigurations> SchoolConfig
@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
@inject ApplicationDbContext dbContext
@{
    var user = await _userManager.GetUserAsync(User);
    var nyer = "";
    if (user != null)
    {
        if (!string.IsNullOrEmpty(user.Fullname) && user.Fullname.Contains(" "))
        {
            var name1 = user.Fullname.Split(" ").Take(1);
            nyer = name1.First();
        }
        else
        {
            nyer = user.Fullname;
        }
    }
    var feedBack = dbContext.FeedBacks.Where(j => j.IsRead == false).OrderByDescending(k => k.Id).ToList();
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>@ViewData["Title"] | @(SchoolConfig.Value.SchoolName) @(SchoolConfig.Value.Layout1)</title>

    <!-- Prevent theme flash: apply saved/preferred theme before first paint -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('agoo-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-bs-theme', saved);
                }
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    @await RenderSectionAsync("Sheets", required: false)
    @await RenderSectionAsync("AddToHead", required: false)
    <!-- Bootstrap -->
    <link href="~/lib/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/main.css">

</head>

<body>
    <div class="d-flex" id="appLayout">

        <!-- ================= SIDEBAR ================= -->
        <div class="sidebar offcanvas-lg offcanvas-start d-flex flex-column" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header d-lg-none border-bottom" style="border-color:rgba(255,255,255,.08) !important;">
                <span class="offcanvas-title fw-semibold text-white" id="sidebarLabel">Menu</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebarOffcanvas"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 p-3 border-bottom flex-shrink-0" style="border-color:rgba(255,255,255,.08) !important;">
                    <svg width="40" height="40" viewBox="0 0 64 64" class="flex-shrink-0">
                        <path d="M32 4 L58 12 V30 C58 46 47 56 32 60 C17 56 6 46 6 30 V12 Z" fill="#0F1C33" stroke="#B08D34" stroke-width="2" />
                        <path d="M32 10 L52 16 V30 C52 43 43 51 32 54 C21 51 12 43 12 30 V16 Z" fill="none" stroke="#D8C089" stroke-width="1" />
                        <text x="32" y="37" font-family="Georgia, serif" font-size="15" font-weight="700" fill="#D8C089" text-anchor="middle">@(SchoolConfig.Value.Abreviation)</text>
                    </svg>
                    <div class="brand-text">
                        <div class="text-white fw-semibold lh-sm" style="font-family:'Fraunces',serif; font-size:1.02rem;">@(SchoolConfig.Value.SchoolName)<br>@(SchoolConfig.Value.Layout1)</div>
                        <div style="color:#D8C089; letter-spacing:.1em; text-transform:uppercase; font-size:.62rem;">School Portal</div>
                    </div>
                </div>

                <nav class="nav flex-column flex-grow-1 py-2" id="sidebarNav">


                    @if (User.IsInRole(SD.IsStudent))
                    {
                        <span class="nav-header d-block px-3 pt-3 pb-1">Student Portal</span>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/Index"><i class="bi bi-mortarboard"></i><span class="nav-text">Student Dashboard</span></a>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/Profile"><i class="bi bi-person-badge"></i><span class="nav-text">My Profile</span></a>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/Payment-Records"><i class="bi bi-cash-stack"></i><span class="nav-text">Fees Payments</span></a>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/PTA-Fees-Payment"><i class="bi bi-piggy-bank"></i><span class="nav-text">PTA Fees Payments</span></a>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/Other-Payment"><i class="bi bi-receipt"></i><span class="nav-text">Other Payments</span></a>
                        <a class="nav-link d-flex align-items-center gap-2" asp-page="/student/Index"><i class="bi bi-printer"></i><span class="nav-text">Print My Results</span></a>
                    }else
                    {
                        <span class="nav-header d-block px-3 pt-2 pb-1">Main</span>
                            <a class="nav-link d-flex align-items-center gap-2" asp-page="/Index"><i class="bi bi-speedometer2"></i><span class="nav-text">Dashboard</span></a>
                            <a class="nav-link d-flex align-items-center gap-2" asp-page="/Admin/System-User/Index"><i class="bi bi-people"></i><span class="nav-text">System Users</span></a>
                            <a class="nav-link d-flex align-items-center gap-2" asp-page="/Admin/system-backup/Index"><i class="bi bi-cloud-arrow-down"></i><span class="nav-text">Restore Database</span></a>


                            <span class="nav-header d-block px-3 pt-3 pb-1">Students</span>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navAdmission" role="button" aria-expanded="false" aria-controls="navAdmission">
                                <i class="bi bi-mortarboard"></i><span class="nav-text">Admission</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navAdmission" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/Admission/Index">List</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Admission/Upsert">New student</a>
                                </div>
                            </div>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navTermReg" role="button" aria-expanded="false" aria-controls="navTermReg">
                                <i class="bi bi-clipboard-check"></i><span class="nav-text">Term Registration</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navTermReg" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/TermRegistration/Index">List</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/TermRegistration/Register">Register Student</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/TermRegistration/Group-Registration">Group Registration</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/TermRegistration/Batch-Registration">Batch Registration</a>
                                </div>
                            </div>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navParents" role="button" aria-expanded="false" aria-controls="navParents">
                                <i class="bi bi-person-hearts"></i><span class="nav-text">Parents/Guardian</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navParents" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/Parents-Guardian/Index">List</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Parents-Guardian/Upsert">Add Parent</a>
                                </div>
                            </div>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navViews" role="button" aria-expanded="false" aria-controls="navViews">
                                <i class="bi bi-diagram-3"></i><span class="nav-text">Views Manager</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navViews" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/ManageYear/Index">Add Session/Year</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/ManageSubject/Index">Add Subject</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/ManageClass/Index">Add Class</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/ManageSubClass/Index">Add Sub-Class</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Expenditure-Type/Index">Add Expense Type</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/manageOtherPay/Index">Other Pay Type</a>
                                </div>
                            </div>

                            <span class="nav-header d-block px-3 pt-3 pb-1">Academics</span>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navCompute" role="button" aria-expanded="false" aria-controls="navCompute">
                                <i class="bi bi-journal-check"></i><span class="nav-text">Compute Result</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navCompute" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Compute-Result/Index">Result Manager Page</a>
                                    <a class="nav-link py-1 small" asp-page="/Compute-Result/Assessment">Assessment Sheet</a>
                                    <a class="nav-link py-1 small" asp-page="/Compute-Result/Add-Result">Add Result</a>
                                    <a class="nav-link py-1 small" asp-page="/Compute-Result/Add-Result-Simplyfy">Simplify Mode</a>
                                    <a class="nav-link py-1 small" asp-page="/Portal/Index">Portal Result</a>
                                </div>
                            </div>

                            <span class="nav-header d-block px-3 pt-3 pb-1">Fees &amp; Expenditure</span>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navFees" role="button" aria-expanded="false" aria-controls="navFees">
                                <i class="bi bi-cash-coin"></i><span class="nav-text">Fees Manager</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navFees" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Fees-Setup/Index">Class Termly Fees</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Fees-Payment/Index">Fees Payment</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Fees-Payment/FeesAnalysis">Fees Analyses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/PTA-Fees-Setup/Index">Termly PTA Fees</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/PTA-Fees/Index">PTA Payment</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/PTA-Fees/PTA-Fees-Analysis">PTA Analyses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/other-Pay/Index">Other Payment</a>
                                </div>
                            </div>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navExpenditure" role="button" aria-expanded="false" aria-controls="navExpenditure">
                                <i class="bi bi-graph-down-arrow"></i><span class="nav-text">Expenditure Manager</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navExpenditure" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Expenditures/Index">Expenses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Expenditures/Upsert">Add Expenses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/Expenditures/Expenditure-Analysis">Expenditure Analyses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/PTA-Expenditure/Index">Add PTA Expenses</a>
                                    <a class="nav-link py-1 small" asp-page="/Admin/Fees-Manager/PTA-Expenditure/Analyses">PTA Expenditure Analyses</a>
                                </div>
                            </div>

                            <span class="nav-header d-block px-3 pt-3 pb-1">Messaging / Website</span>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navMessage" role="button" aria-expanded="false" aria-controls="navMessage">
                                <i class="bi bi-envelope-paper"></i><span class="nav-text">Message Manager</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navMessage" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/Messaging/Send-SMS/Index">Send SMS</a>
                                    <a class="nav-link py-1 small" asp-page="/Messaging/Feed-Back/Compose-Message">Send Email</a>
                                    <a class="nav-link py-1 small" asp-page="/Messaging/Feed-Back/Index">Feed Back</a>
                                </div>
                            </div>

                            <a class="nav-link d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" href="#navWebsite" role="button" aria-expanded="false" aria-controls="navWebsite">
                                <i class="bi bi-globe2"></i><span class="nav-text">Manage Website</span><i class="bi bi-chevron-right ms-auto chevron"></i>
                            </a>
                            <div class="collapse" id="navWebsite" data-bs-parent="#sidebarNav">
                                <div class="d-flex flex-column ps-4">
                                    <a class="nav-link py-1 small" asp-page="/WebsiteManager/TeamManagers/Index">Manage Team</a>
                                    <a class="nav-link py-1 small" asp-page="/WebsiteManager/WebGallery/Index">Manage Gallery</a>
                                    <a class="nav-link py-1 small" asp-page="/WebsiteManager/WebNews/Index">Manage News</a>
                                </div>
                            </div>
                        }
                    </nav>
                
                <div class="p-3 border-top flex-shrink-0" style="border-color:rgba(255,255,255,.08) !important;">
                    <form class="m-0" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("Login")">
                        <button type="submit" class="nav-link d-flex align-items-center gap-2 p-0 border-0 bg-transparent text-reset w-100 text-start"><i class="bi bi-box-arrow-right"></i><span class="nav-text">Sign out</span></button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= MAIN (its own independent scroll) ================= -->
        <div class="flex-grow-1 d-flex flex-column" id="mainContent" data-bs-spy="scroll" data-bs-target="#sidebarNav" data-bs-smooth-scroll="true" tabindex="0" style="height:100vh; overflow-y:auto;">

            <!-- Topbar -->
            <div class="d-flex align-items-center justify-content-between bg-body border-bottom p-2 px-3 sticky-top flex-shrink-0" style="z-index:1030;">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-0" id="sidebarToggle" type="button" style="width:38px;height:38px;" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="input-group input-group-sm d-none d-sm-flex" style="max-width:300px;">
                        <span class="input-group-text bg-body border-end-0"><i class="bi bi-search text-body-secondary"></i></span>
                        <input type="search" class="form-control border-start-0" placeholder="Search students, staff, records&hellip;">
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-body-secondary d-none d-md-inline" id="clock"></span>
                    <button class="btn btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-0" id="themeToggle" type="button" style="width:38px;height:38px;" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                        @if (!User.IsInRole(SD.IsStudent))
                        {
                            <div id="balpro" class="d-none d-xl-inline-block small text-body-secondary"></div>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary rounded-circle position-relative d-inline-flex align-items-center justify-content-center p-0" data-bs-toggle="dropdown" type="button" style="width:38px;height:38px;">
                                    <i class="bi bi-bell"></i>
                                    @if (feedBack.Any())
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light"><span>@feedBack.Count</span><span class="visually-hidden">unread notifications</span></span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:320px;">
                                    <li><h6 class="dropdown-header">Notifications</h6></li>
                                    @if (feedBack.Any())
                                    {
                                        @foreach (var item in feedBack.Take(5))
                                        {
                                            string msg = item.Subject.Length > 29 ? item.Subject.Substring(0, 30) : item.Subject;
                                            <li>
                                                <a asp-page="/Messaging/Feed-Back/Message-Detail" asp-route-id="@item.Id" class="dropdown-item">
                                                    <div class="d-flex gap-2 align-items-start">
                                                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white flex-shrink-0" style="width:34px;height:34px;"><i class="bi bi-envelope"></i></span>
                                                        <div class="min-w-0">
                                                            <div class="fw-semibold small">@(item.Name)</div>
                                                            <div class="small text-body-secondary text-truncate">@(msg)</div>
                                                            <div class="small text-body-secondary"><i class="bi bi-clock me-1"></i>@(SD.TimeAgo(item.CreatedDate))</div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li><span class="dropdown-item-text small text-body-secondary">No unread notifications.</span></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item small text-center" asp-page="/Messaging/Feed-Back/Index"><i class="bi bi-arrow-down-circle me-1"></i>Load More..</a></li>
                                </ul>
                            </div>
                        }
                        <div class="dropdown">
                        <button class="btn p-0 d-flex align-items-center gap-2 border-0 bg-transparent" data-bs-toggle="dropdown" type="button">
                            @if (_signInManager.IsSignedIn(User) && user != null)
                            {
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold" style="width:38px;height:38px;font-family:'Fraunces',serif;font-size:.85rem;">@(string.IsNullOrWhiteSpace(user?.Fullname) ? "U" : (string.Concat(user.Fullname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])) is string initStr && !string.IsNullOrEmpty(initStr) ? initStr : "U"))</span>
                                <span class="d-none d-md-inline small fw-semibold">@(nyer) <i class="bi bi-chevron-down small ms-1"></i></span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                @if (User.IsInRole(SD.IsStudent))
                                {
                                    <li>
                                        <a class="dropdown-item small" asp-page="/student/Profile"><i class="bi bi-person me-2"></i>Profile</a>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item small" asp-page="/Appsettings/Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="p-0" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("Login")">
                                    <button type="submit" class="dropdown-item small"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

                <!-- Content -->
            <div class="container-fluid p-3 p-md-4 flex-grow-1 d-flex flex-column">

                    @RenderBody()
                <footer class="d-flex justify-content-between flex-wrap gap-2 border-top pt-3 mt-auto mb-2 small text-body-secondary">
                    <span>&copy; @(DateTime.Now.Year) <b style="color:var(--bs-heading-color);">@(SchoolConfig.Value.SchoolName) @(SchoolConfig.Value.Layout1) </b>. All rights reserved. V 1.0.2.</span>
                    <span>School Portal &middot; Developed By: <b style="color:var(--bs-heading-color);">D-Best Return Tech&copy;</b></span>
                </footer>

            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/balance.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
