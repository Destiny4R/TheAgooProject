@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
@inject ApplicationDbContext dbContext
@{
    var user = await _userManager.GetUserAsync(User);
    var nyer = "";
    if (user != null)
    {
        if (!string.IsNullOrEmpty(user.Fullname) && user.Fullname.Contains(" "))
        {
            var name1 = user.Fullname.Split(" ").Take(1);
            nyer = name1.First();
        }
        else
        {
            // Handle cases where Fullname doesn't meet the expected format
            nyer = user.Fullname; // or any other fallback logic
        }
    }
    var feedBack = dbContext.FeedBacks.Where(j => j.IsRead == false).OrderByDescending(k=>k.Id).ToList();

}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | Aggo College Makurdi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Thereturnpark.com" name="domain" />
    <meta content="The Return Tech" name="Japheth" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/favicon.ico">


    <!-- slick css -->
    <link href="/assets/libs/slick-slider/slick/slick.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/slick-slider/slick/slick-theme.css" rel="stylesheet" type="text/css" />

    <!-- jvectormap -->
    <link href="/assets/libs/jqvmap/jqvmap.min.css" rel="stylesheet" />
    @await RenderSectionAsync("AddToHead",required: false)
    <!-- Bootstrap Css -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body data-sidebar="dark">
    
