                            <div class="dropdown-divider"></div>
                            <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("Login")">
                                <button type="submit" class="nav-link btn btn-link text-dark"><i class="mdi mdi-logout h5"></i> Logout</button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
