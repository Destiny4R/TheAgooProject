                            <img class="rounded-circle header-profile-user" src="/appicons/android-icon-192x192.png"
                                 alt="Header Avatar" />
                            @if (_signInManager.IsSignedIn(User))
                            {
                                <span class="d-none d-sm-inline-block ml-1">@(nyer)</span>
                            }
                            <i class="mdi mdi-chevron-down d-none d-sm-inline-block"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
