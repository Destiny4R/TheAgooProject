@page
@model TheAgooProjectWeb.Pages.Admin.ManageSubject.IndexModel
@{
    ViewData["Title"] = "Subject List";
    ViewData["SubTitle"] = "Manage school subjects and registrations";
}
@section Sheets{
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
    <link href="~/lib/jquery-multiselect/jquery.multiselect.css" rel="stylesheet" />
}

<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-journal-text me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#subjectsModal">
                <i class="bi bi-journal-plus me-1"></i> Register Subjects
            </button>
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
                <i class="fas fa-plus me-2"></i> Add Subject
            </button>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="classtable" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Subject Code</th>
                        <th>Subject Name</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<div class="modal fade" id="subjectsModal" tabindex="-1" aria-labelledby="subjectsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title fs-5 h2" id="subjectsModalLabel">Subject Registration</div>
                <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ManageSubject">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <label for="validationCustom04" class="form-label">Select Subjects</label>
                            <select class="form-select active 2col form-control" required multiple name="subjects[]" asp-items="Model.ViewSelectModel.Subjects">
                                @* <option selected disabled value="">Choose...</option> *@
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--ADD SUBJECT Modal -->
<div class="modal fade" id="addSubjectModal" tabindex="-1" aria-labelledby="addSubjectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="addClassModalLabel">Add New Subject</h1>
                    <small>Manage new Subject infomation</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddAndUpdate">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="subject.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="subject.Name" required />
                        <span asp-validation-for="subject.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--EDIT Subject Modal -->
<div class="modal fade" id="editSubjectModal" tabindex="-1" aria-labelledby="editSubjectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="editSubjectModalLabel">Edit Subject</h1>
                    <small>Manage subject information</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddAndUpdate">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="subject.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="subject.Name" required />
                        <span asp-validation-for="subject.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
                <input type="hidden" asp-for="subject.Id" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/lib/jquery-multiselect/jquery.multiselect.js"></script>
    <script src="~/js/subjects.js"></script>
    <script>
        $(function () {
            $('select[multiple].active.2col').multiselect({
                columns: 2,
                placeholder: 'Select Subjects',
                search: true,
                searchOptions: {
                    'default': 'Search Subject'
                },
                selectAll: true
            });

        });
    </script>
}
