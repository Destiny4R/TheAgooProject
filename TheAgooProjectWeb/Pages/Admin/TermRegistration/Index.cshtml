@page
@model TheAgooProjectWeb.Pages.Admin.TermRegistration.IndexModel
@{
    ViewData["Title"] = "Registered Students";
    ViewData["SubTitle"] = "View and manage term registrations";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-list-check me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Group-Registration" class="btn btn-outline-light btn-sm"><i class="bi bi-people me-1"></i> Group Registration</a>
            <a asp-page="Batch-Registration" class="btn btn-outline-light btn-sm"><i class="bi bi-people me-1"></i> Batch Registration</a>
            <a asp-page="Register" class="btn btn-outline-light btn-sm"><i class="bi bi-person-plus me-1"></i> Register student</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <form method="post" id="thecheckhouse">

                <div class="row">
                    <div class="col-lg-4">
                        <div class="input-group mb-3">
                            <div class="">
                                <input type="checkbox" asp-for="CheckAll2" id="checkAll" />&nbsp;
                                <label class="form-check-label" for="checkAll">Check All</label>
                            </div>
                            &emsp;
                            <button type="submit" title="Delete multiple records" class="btn btn-sm btn-outline-dark"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="mb-2">
                                    <label class="form-label">Term</label>
                                    <select asp-for="CTSSClass.Term" class="form-control form-control-sm">
                                        <option value="" disabled selected>---Select Term---</option>
                                        <option value="First">First</option>
                                        <option value="Second">Second</option>
                                        <option value="Third">Third</option>
                                    </select>
                                    <span asp-validation-for="CTSSClass.Term" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-2">
                                    <label class="form-label">Year/Session</label>
                                    <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                        <option value="" disabled selected>---Select Session/Year---</option>
                                    </select>
                                    <span asp-validation-for="CTSSClass.SessionYear" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-2">
                                    <label class="form-label">Class</label>
                                    <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                        <option value="" disabled selected>---Select Class---</option>
                                    </select>
                                    <span asp-validation-for="CTSSClass.Classes" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-2">
                                    <label class="form-label">Sub Class</label>
                                    <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                        <option value="" disabled selected>---Select Sub-Class---</option>
                                    </select>
                                    <span asp-validation-for="CTSSClass.Subclass" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <table class="table table-sm table-bordered table-hover table-striped" id="termregtable1" width="100%">
                    <thead>
                        <tr>
                            <th>S/N</th>
                            <th></th>
                            <th>Full Name</th>
                            <th>Student Reg</th>
                            <th>Term</th>
                            <th>Session/Year</th>
                            <th>Class</th>
                            <th>Sub-Class</th>
                            <th>No. Subjects</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/termregtable.js" asp-append-version="true"></script>
}