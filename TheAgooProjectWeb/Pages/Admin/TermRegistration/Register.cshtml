@page
@model TheAgooProjectWeb.Pages.Admin.TermRegistration.RegisterModel
@{
    ViewData["Title"] = "Register Student";
    ViewData["SubTitle"] = "Register a student for the term";
}
@section Sheets {
    <link href="~/lib/jquery-multiselect/jquery.multiselect.css" rel="stylesheet" />
    @* <link href="~/lib/multipleselect/multiselect.css" rel="stylesheet" /> *@
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-clipboard-check me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-header">
            <div class="mt-2">
                <div class="col-auto">
                    <div class="mt-3 row">
                        <div class="col-md-6 offset-md-6">
                            <form method="post" asp-page-handler="Search">
                                <div class="input-group mb-3">
                                    <input type="search" name="regnumber" class="form-control" placeholder="Enter Registration Number" aria-label="Enter Registration Number" >
                                    <button type="submit" class="input-group-text btn-success"><i class="bi bi-search me-2"></i>Search</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.verify > 0)
        {
            <div class="card-body">
                <form class="form-horizontal" method="post" asp-page-handler="Register">
                <div class="row justify-content-center1">
                    <div class="alert alert-primary col-12"><h5 class="text-center">Complete the Registration Form</h5></div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Full Name</label>
                                <input class="form-control form-control-sm" readonly asp-for="input.Fullname" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Student Registration Number</label>
                                <input class="form-control form-control-sm" readonly asp-for="input.StudentReg" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Term</label>
                                <select asp-for="CTSSClass.Term" class="form-control form-control-sm custom-select">
                                    <option value="" disabled selected>---Select Term---</option>
                                    <option value="First">First</option>
                                    <option value="Second">Second</option>
                                    <option value="Third">Third</option>
                                </select>
                                <span asp-validation-for="CTSSClass.Term" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Session/Year</label>
                                <select class="form-control form-control-sm custom-select" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <span asp-validation-for="CTSSClass.SessionYear" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Class</label>
                                <select class="form-control form-control-sm  custom-select" asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                    <option value="" disabled selected>---Select Class---</option>
                                </select>
                                <span asp-validation-for="CTSSClass.Classes" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label">Sub-Class</label>
                                <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm custom-select" asp-items="Model.ViewSelectModel.SubClass">
                                    <option value="" disabled selected>---Select Sub-Class---</option>
                                </select>
                                <span asp-validation-for="CTSSClass.Subclass" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-2">
                                <label class="form-label">Register Subjects</label>
                                <select required class="custom-select form-control-sm 2col active" multiple name="subjects[]" asp-items="Model.ViewSelectModel.Subjects">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mt-4">
                                <button class="btn btn-success btn-block waves-effect waves-light" type="submit">Register</button>
                            </div>
                        </div>
                       
                        <input type="hidden" asp-for="input.StudentId" />
                      </div>
                </form>
            </div>
        }
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    @* <script src="~/lib/multipleselect/multiselect.js"></script> *@
    <script src="~/lib/jquery-multiselect/jquery.multiselect.js"></script>
    <script>
        $(function () {
            $('select[multiple].active.2col').multiselect({
                columns: 2,
                placeholder: 'Select Subjects',
                search: true,
                searchOptions: {
                    'default': 'Search Subject'
                },
                selectAll: true
            });

        });
    </script>
}