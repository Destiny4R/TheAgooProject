@page
@model TheAgooProjectWeb.Pages.Admin.TermRegistration.Batch_RegistrationModel
@{
    ViewData["Title"] = "Buck Students Term Registration";
    ViewData["SubTitle"] = "Duplicate previous term registrations in bulk";
    int sn = 0;
}
<link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-clipboard-check me-2"></i> Duplicate Previous Term Registeration
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-header">
            <div class="mt-2">
                <form method="post" asp-page-handler="Search">
                    <div class="g-2 mt-2 row">
                        <div class="col-md-3">
                            <select asp-for="CTSSClass.Term" class="form-select form-control-sm">
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Term" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Classes" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <select asp-for="CTSSClass.Subclass" class="form-select form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        @if (Model.hasValue > 0)
        {
            <div class="card-body">
                <form method="post" asp-page-handler="PostAll">
                    <div class="input-group mt-2 row">
                        <div class="col-md-3">
                            <select asp-for="RegCtssClass.Term" class="form-select form-control-sm">
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option>
                                <option value="Second">Second</option>
                                <option value="Third">Third</option>
                            </select>
                            <span asp-validation-for="RegCtssClass.Term" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-control-sm" asp-for="RegCtssClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <span asp-validation-for="RegCtssClass.SessionYear" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-control-sm " asp-for="RegCtssClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <span asp-validation-for="RegCtssClass.Classes" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <select asp-for="RegCtssClass.Subclass" class="form-select form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                            <span asp-validation-for="RegCtssClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                    </div>
                    <table id="termregTable" class="table table-boredered table-responsive table-striped table-sm mt-2">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Student Reg No:</th>
                                <th>Term</th>
                                <th>Session/Year</th>
                                <th>Class</th>
                                <th>Sub Class</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.TermReg.Count(); i++)
                            {
                                sn++;
                                <tr>
                                    <td>@(sn)</td>
                                    <td>@(Model.TermReg[i].StudentsData.SurName+" "+Model.TermReg[i].StudentsData.OtherName+" "+Model.TermReg[i].StudentsData.FirstName)</td>
                                    <td><input class="form-control form-control-sm" asp-for="@Model.TermReg[i].StudentsData.StudentRegNo" readonly/></td>
                                    <td>@(Model.TermReg[i].Term)</td>
                                    <td>@(Model.TermReg[i].SessionYear.Name)</td>
                                    <td>@(Model.TermReg[i].Schoolclasses.Name)</td>
                                    <td>@(Model.TermReg[i].SubClasses.Name)</td>
                                    <td>
                                        <input type="hidden" asp-for="@Model.TermReg[i].Id"/>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="Remove(this);"><i class='bi bi-trash'></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                </table>
                <div class="row">
                    <div class="col-sm-8 offset-sm-1">
                            <button type="submit" class="btn btn-primary">Register All</button>
                    </div>
                </div>
                <input type="hidden" asp-for="ctsscl.SessionYear"/>
                <input type="hidden" asp-for="ctsscl.Classes"/>
                <input type="hidden" asp-for="ctsscl.Subclass"/>
                <input type="hidden" asp-for="ctsscl.Term"/>
            </form>
        </div>
        }
     </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        function Remove(button) {
            //Determine the reference of the Row using the Button.
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(1).html();

            Swal.fire({
                title: "Are you sure you don't want to register " + name + "?",
                showDenyButton: true,
                confirmButtonText: "Yes, Remove!",
                denyButtonText: `Cancel`
            }).then((result) => {
                if (result.isConfirmed) {
                    var table = $("#termregTable")[0];
                    table.deleteRow(row[0].rowIndex);
                    Swal.fire("Deleted!", name + " successfully removed, if it was a mistake, kindly research", "success");
                } else if (result.isDenied) {
                    Swal.fire(name + " not deleted", "", "info");
                }
            });
        };
    </script>
}