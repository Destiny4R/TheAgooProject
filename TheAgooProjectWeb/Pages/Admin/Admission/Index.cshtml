@page
@model TheAgooProjectWeb.Pages.Admin.Admission.IndexModel
@{
    ViewData["Title"] = "Student Admission List";
    ViewData["SubTitle"] = "Register and manage student admission";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-mortarboard me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Upsert" class="btn btn-light btn-sm"><i class="bi bi-person-plus me-1"></i> Add Student</a>
        </div>
    </div>
    @if(TempData["success"] != null){
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong><i class="fas fa-check-double text-success"></i>&emsp; </strong> @TempData["success"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="subjectTablez" class="table table-hover table-striped table-sm" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Full Name</th>
                        <th>Student Reg. No.</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>State</th>
                        <th>Local Govt</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/studentregdata.js" asp-append-version="true"></script>
}