@page
@model TheAgooProjectWeb.Pages.Admin.System_User.IndexModel
@{
    ViewData["Title"] = "List of System Users";
    ViewData["SubTitle"] = "View and manage system user accounts";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-people me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-person-plus me-1"></i> Add User</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-check-double text-success"></i></strong> &emsp; @TempData["success"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="tablesystemusers" class="table table-stripe">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>UserName</th>
                        <th>User Status</th>
                        <th>Role</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/systemuserdata.js" asp-append-version="true" ></script>
}