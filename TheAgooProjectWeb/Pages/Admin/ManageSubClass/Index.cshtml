@page
@model TheAgooProjectWeb.Pages.Admin.ManageSubClass.IndexModel
@{
    ViewData["Title"] = "Sub-Class List";
    ViewData["SubTitle"] = "Manage class sub-divisions";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-diagram-3 me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addSubClassModal">
                <i class="bi bi-pencil-square me-2"></i> Add Subject
            </button>
            @* <a href="ManageSubClass/Upsert" class="btn btn-light btn-sm"><i class="bi bi-plus me-1"></i> Add Sub-class</a> *@
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="subclasstable" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th> Sub-Class</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!--Add SubClass Modal -->
<div class="modal fade" id="addSubClassModal" tabindex="-1" aria-labelledby="addSubClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="addSubClassModalLabel"><i class="bi bi-diagram-3 me-2"></i>Add New Sub Class</h1>
                    <small>Manage new Sub-Class infomation</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="subClass.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="subClass.Name" required />
                        <span asp-validation-for="subClass.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Edit SubClass Modal -->
<div class="modal fade" id="editSubClassModal" tabindex="-1" aria-labelledby="editSubClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="editSubClassModalLabel"><i class="bi bi-diagram-3 me-2"></i>Edit Sub Class</h1>
                    <small>Manage Sub-Class infomation</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="subClass.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="subClass.Name" required />
                        <span asp-validation-for="subClass.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
                <input type="hidden" asp-for="subClass.Id" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/subclass.js"></script>
}
