@page
@model TheAgooProjectWeb.Pages.Admin.Parents_Guardian.UpsertModel
@{
    ViewData["Title"] = Model.Parent?.Id > 0 ? "Update Parent Information" : "Add Parent";
    string name = Model.Parent?.Id > 0 ? "Update" : "Save";
}

<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge bg-dark"><h4 class="text-white">@(ViewData["Title"])</h4></div>

                <div class="">
                    <a class="btn btn-info btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
                </div>
            </div>
            <div class="mt-2">
                <div class="col-auto">
                    <div class="mt-3 row">
                        <div class="col-md-6"></div>
                        <div class="col-md-6">
                            <form method="post" asp-page-handler="Search">
                                <div class="input-group mb-2">
                                    <input class="form-control" type="search" name="regnumber" required placeholder="Enter Registration Number" />
                                    <span class="input-group-prepend">
                                        <button class="btn btn-success"><i class="fas fa-search"></i></button>
                                    </span>
                                </div>
                            </form>
                            @if (TempData["success"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                    <strong><i class="fas fa-info-circle"></i>  </strong> @TempData["success"].
                                </div>
                            }
                            @if (TempData["error"] != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                    <strong><i class="fas fa-exclamation-triangle"></i> </strong> @TempData["error"].
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.data > 0)
        {
            <div class="card-body">
                <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="p-2">
                            <div class="alert alert-primary"><h5 class="text-center">@(ViewData["Title"])</h5></div>
                        <form class="form-horizontal" method="post" asp-page-handler="Send">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group mb-2">
                                        <label for="username">Full Name</label>
                                        <input class="form-control form-control-sm" readonly asp-for="studentName" />
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="username">Student Registration Number</label>
                                        <input class="form-control form-control-sm" readonly asp-for="studentRegNo" />
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="username">Parent Full Name</label>
                                        <input class="form-control form-control-sm" asp-for="Parent.Name" />
                                        <span asp-validation-for="Parent.Name" class="text-white bg-danger badage"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="useremail">Phone Number</label>
                                        <input class="form-control form-control-sm" asp-for="Parent.PhoneNumber" />
                                        <span asp-validation-for="Parent.PhoneNumber" class="text-white bg-danger badage"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Relationship</label>
                                        <input class="form-control form-control-sm" asp-for="Parent.Relationship" />
                                        <span asp-validation-for="Parent.Relationship" class="text-white bg-danger badage"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Occupation</label>
                                        <input class="form-control form-control-sm" asp-for="Parent.Occupation" />
                                        <span asp-validation-for="Parent.Occupation" class="text-white bg-danger badage"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Address</label>
                                        <input class="form-control form-control-sm" asp-for="Parent.Address" />
                                        <span asp-validation-for="Parent.Address" class="text-white bg-danger badage"></span>
                                    </div>
                                    <div class="mt-4">
                                            <button class="btn btn-primary btn-block waves-effect waves-light" type="submit">@(name)</button>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Parent.Id" />
                        </form>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}