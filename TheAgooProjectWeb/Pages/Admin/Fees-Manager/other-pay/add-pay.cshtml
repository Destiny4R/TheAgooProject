@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.other_pay.add_payModel
@{
    ViewData["Title"] = "Make Other Payment";
    ViewData["SubTitle"] = "Record other payment for a student";
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-wallet2 me-2"></i> Make Other Payment
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Record other payment for a student</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
        </div>
    }
    <div class="card">
        <div class="card-header">
            <div class="mt-3">
                <form method="post" asp-page-handler="Search">
                    <div class="row g-0 mt-2">
                        <div class="col-md-3 row">
                            <select asp-for="CTSSClass.Term" class="form-select col-md-6" required>
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option>
                                <option value="Second">Second</option>
                                <option value="Third">Third</option>
                            </select>
                            <select class="form-select  col-md-6" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz" required>
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <select asp-for="CTSSClass.Subclass" class="form-select" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" name="OtherPayId" asp-items="Model.OtherPay" required>
                                <option value="" disabled selected>---Select payment for---</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-3">
                                <input type="search" name="search" required maxlength="30" class="form-control" placeholder="Registration Number" >
                                <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

        </div>
        <div class="card-body">
            @if (Model.IsSearch>0)
            {
                <form class="g-3" method="post" asp-page-handler="Payment">
                    <div class=" row">
                        <div class="input-group mb-3 col-sm-6">
                            <span class="input-group-text form-control" id="basic-addon3">Full Name:</span>
                            <span class="input-group-text form-control" id="basic-addon3">@Model.modelData.FullName</span>
                        </div>
                        <div class="input-group mb-3 col-sm-6">
                            <span class="input-group-text form-control" id="basic-addon3">Student Reg. No.:</span>
                            <span class="input-group-text form-control" id="basic-addon3">@Model.modelData.StudentReg</span>
                        </div>
                    </div>
                    <div class=" row">
                        <div class="input-group mb-3 col-sm-12">
                            <span class="input-group-text form-control">@Model.modelData.SessionYear</span>
                            <span class="input-group-text form-control">@Model.modelData.Term</span>
                            <span class="input-group-text form-control">@Model.modelData.Classes</span>
                            <span class="input-group-text form-control">@Model.modelData.Subclass</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mt-3">
                            <label class="form-label">Other Type</label>
                            <input class="form-control" asp-for="modelData.OtherPayType" readonly />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label for="inputPassword4" class="form-label">Other Amount To Pay</label>
                            <input readonly class="form-control" value="@Model.modelData.Amount" />
                        </div>
                        <div class="col-sm-6 mt-3">
                            <label for="inputAddress" class="form-label">Anount Paying</label>
                            <input class="form-control" asp-for="modelData.Amount" readonly />
                        </div>
                        <div class="">
                            <input type="hidden" asp-for="modelData.TermRegId">
                            <input type="hidden" asp-for="modelData.SpecialpayId">
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-primary">Confirm Payment</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>