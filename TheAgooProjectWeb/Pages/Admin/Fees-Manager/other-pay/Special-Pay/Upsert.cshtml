@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.other_pay.Special_Pay.UpsertModel
@{
    ViewData["Title"] = Model.specialPay.Id > 0 ? "Update Special Payments Fees" : "Add Special Payment Fees";
    ViewData["SubTitle"] = "Add or update special payment fees";
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-tags me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Add or update special payment fees</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div class="p-2">
                        <form class="form-horizontal" method="post">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group mb-2">
                                        <label for="">Pay for</label>
                                        <select class="form-control form-control-sm" asp-for="specialPay.OtherPayId" asp-items="Model.OtherPay">
                                            <option value="" disabled selected>---Select payment for---</option>
                                        </select>
                                        <span asp-validation-for="specialPay.SessionYearId" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="username">Term</label>
                                        <select asp-for="specialPay.Term" class="form-control form-control-sm">
                                            <option value="" disabled selected>---Select Term---</option>
                                            <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                                        </select>
                                        <span asp-validation-for="specialPay.Term" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="">Session/Year</label>
                                        <select class="form-control form-control-sm" asp-for="specialPay.SessionYearId" asp-items="Model.ViewSelectModel.SessionYearz">
                                            <option value="" disabled selected>---Select Session/Year---</option>
                                        </select>
                                        <span asp-validation-for="specialPay.SessionYearId" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Class</label>
                                        <select class="form-control form-control-sm " asp-for="specialPay.ClassesInSchoolId" asp-items="Model.ViewSelectModel.Class">
                                            <option value="" disabled selected>---Select Class---</option>
                                        </select>
                                        <span asp-validation-for="specialPay.ClassesInSchoolId" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Amount</label>
                                        <input asp-for="specialPay.Amount" class="form-control" />
                                        <span asp-validation-for="specialPay.Amount" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="mt-4">
                                        <button class="btn btn-primary btn-block waves-effect waves-light" type="submit">
                                            @(Model.specialPay.Id > 0 ? "Update" : "Add fees")
                                        </button>
                                        <input type="hidden" asp-for="specialPay.Id" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
