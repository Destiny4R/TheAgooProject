@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.other_pay.Special_Pay.IndexModel
@{
    ViewData["Title"] = "Special Payment";
    ViewData["SubTitle"] = "Manage special payment types and amounts";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-tags me-2"></i> Pay History
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Manage special payment types and amounts</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus me-1"></i>&nbsp; Add Class Pay</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="whattopay" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Pay Type</th>
                        <th>Amount</th>
                        <th>Session/Year</th>
                        <th>Term</th>
                        <th>Class</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/whattopay.js"></script>
}