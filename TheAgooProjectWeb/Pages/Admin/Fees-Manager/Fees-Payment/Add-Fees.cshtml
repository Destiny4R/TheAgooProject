@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Fees_Payment.Add_FeesModel
@{
    ViewData["Title"] = "Make Fees Payment";
    ViewData["SubTitle"] = "Record fees payment for a student";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash-coin me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Record fees payment for a student</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
        </div>
    }
    <div class="card">
        <div class="card-header">
            <div class="mt-3">
                <form method="post" asp-page-handler="Search">
                    <div class="row mt-2">
                        <div class="col-sm-2">
                            <select asp-for="CTSSClass.Term" class="form-control form-control-sm">
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Term" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-2">
                            <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-2">
                            <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Classes" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        @* <div class="col-sm-2">
                            <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div> *@
                        <div class="col-sm-3">
                            <input class="form-control form-control-sm" type="search" name="studentReg" required placeholder="Student Reg No" />
                        </div>
                        <div class="col-sm-1">
                            <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        @if (Model.payx > 0 )
        {
            <div class="card-body alert-info">
                @if (Model.viewDataInfo != null)
                {
                    <div class="mt-3">
                        <form method="post" asp-page-handler="Payment">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div>
                                        <h5 class="font-size-14">Full Name</h5>
                                        <input class="form-control  form-control-sm" value="@(Model.viewDataInfo.Fullname)" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="mt-4 mt-md-0">
                                        <h5 class="font-size-14">Student Reg Number</h5>
                                        <input class="form-control form-control-sm" value="@(Model.viewDataInfo.StudentReg)" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-4 mt-4 ">
                                    <div class="mt-md-0">
                                        <h5 class="font-size-14">Session/Year</h5>
                                        <input class="form-control form-control-sm" value="@(Model.viewDataInfo.SessionYear)" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-4 mt-4 ">
                                    <div class="mt-md-0">
                                        <h5 class="font-size-14">Term</h5>
                                        <input class="form-control form-control-sm" value="@(Model.viewDataInfo.Term)" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-4 mt-4 ">
                                    <div class="mt-md-0">
                                        <h5 class="font-size-14">Class</h5>
                                        <input class="form-control form-control-sm" value="@(Model.viewDataInfo.Classes)" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-3 mt-3">
                                    <div>
                                        <h5 class="font-size-14">Fees</h5>
                                        <input id="fees" class="form-control  form-control-sm" required asp-for="viewDataInfo.Fees" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3 mt-3">
                                    <div class="">
                                        <h5 class="font-size-14">Payment</h5>
                                        <input class="form-control form-control-sm" autocomplete="off" onkeyup="sum();" asp-for="viewDataInfo.Amount" />
                                    </div>
                                </div>
                                <div class="col-sm-3 mt-3">
                                    <div class="mt-md-0">
                                        <h5 class="font-size-14">Balance</h5>
                                        <input class="form-control form-control-sm" required asp-for="viewDataInfo.TotalBalance" readonly />
                                    </div>
                                </div>
                                <div class="col-sm-3 mt-3">
                                    <div class=" mt-md-0">
                                        <h5 class="font-size-14">Total Amount Paid</h5>
                                        <input class="form-control form-control-sm" required asp-for="viewDataInfo.TotalPayment" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 mt-3">
                                    <div>
                                        <h5 class="font-size-14">Description</h5>
                                        <input class="form-control" data-val="false" asp-for="viewDataInfo.Description" placeholder="Narration" />
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-primary btn-sm " type="submit">Pay</button>
                            </div>
                            <input asp-for="viewDataInfo.TermRegId" type="hidden" />
                            <input asp-for="viewDataInfo.TermFeesId" type="hidden" />
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script>
        function sum() {
            let fees = $("#fees").val();
            let amount = $("#viewDataInfo_Amount").val();
            let oldpay = $("#viewDataInfo_TotalPayment").val();
            let answer = Number(fees) - (Number(amount) + Number(oldpay));
            let wrong = Number(fees) - Number(oldpay)
            $("#viewDataInfo_TotalBalance").val(answer);
            if (Number(amount) > Number(wrong)) {
                Swal.fire({
                    title: "Invalid Payment",
                    text: "Amount to pay should be greater than Fees",
                    icon: "error",
                    confirmButtonColor: "#3d8ef8"
                });
                $("#viewDataInfo_Amount").val(0);
                $("#viewDataInfo_TotalBalance").val(fees - oldpay);
            }
            if (answer < 0) {
                Swal.fire({
                    title: "Invalid Payment",
                    text: "Over payment detected",
                    icon: "error",
                    confirmButtonColor: "#3d8ef8"
                });
                $("#viewDataInfo_Amount").val(0)
                $("#viewDataInfo_TotalBalance").val(fees - oldpay);
            }
            
        }
    </script>
}