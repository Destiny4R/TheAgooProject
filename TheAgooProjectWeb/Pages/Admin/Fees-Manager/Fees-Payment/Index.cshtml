@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Fees_Payment.IndexModel
@{
    ViewData["Title"] = "Termly Fees Payment List";
    ViewData["SubTitle"] = "Track and manage termly fees payments";
    int sn = 0;
    string classx = "";
    if (Model.IsSearch > 0)
    {
        classx = "table-responsive";
    }
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash me-2"></i> Payment List
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Track and manage termly fees payments</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-light btn-sm" asp-page="FeesAnalysis"><i class="bi bi-bar-chart-line me-1"></i>&ensp; Fees Analyses</a>
            <a class="btn btn-outline-light btn-sm" asp-page="Add-Fees"><i class="bi bi-plus me-1"></i>&ensp; Add Payment</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
        </div>
    }
    <div class="card">
        <div class="card-header">
            <div class="mt-3">
                <form method="post">
                    <div class="row mt-2">
                        <div class="col-sm-2">
                            <select asp-for="CTSSClass.Term" class="form-control form-control-sm">
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option>
                                <option value="Second">Second</option>
                                <option value="Third">Third</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Term" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-2">
                            <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-2">
                            <select class="form-control form-control-sm " asp-for="CTSSClass.Classes" asp-items="Model.ViewSelectModel.Class">
                                <option value="" disabled selected>---Select Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Classes" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-2">
                            <select asp-for="CTSSClass.Subclass" class="form-control form-control-sm" asp-items="Model.ViewSelectModel.SubClass">
                                <option value="" disabled selected>---Select Sub-Class---</option>
                            </select>
                            <span asp-validation-for="CTSSClass.Subclass" class="text-white field-validation-valid badge badge-danger"></span>
                        </div>
                        <div class="col-sm-1">
                            <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="card-body">
            <table id="fee_payment" class="table table-boredered table-striped table-sm @classx">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Student Reg No.</th>
                        <th>Fees</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Session/Year</th>
                        <th>Term</th>
                        <th>Class</th>
                        <th>Action</th>
                    </tr>
                </thead>
                @if (Model.IsSearch > 0)
                {
                    <tbody>
                        @foreach (var item in Model.PaymentReports)
                        {
                            sn++;
                            <tr>
                                <td>@(sn)</td>
                                <td>@(item.Termregistration.StudentsData.SurName + " " + item.Termregistration.StudentsData.OtherName + " " + item.Termregistration.StudentsData.FirstName)</td>
                                <td>@(item.Termregistration.StudentsData.StudentRegNo)</td>
                                <td>@(SD.ToNaira(item.TermlyFees.Amount))</td>
                                <td>@(SD.ToNaira(item.AccummulatedPay))</td>
                                <td>@(SD.ToNaira(item.TermlyFees.Amount - item.AccummulatedPay))</td>
                                <td>
                                    @if (item.Status == SD.Fees_Status_Completed)
                                    {
                                        <span class="badge h4 bg-success" title="Fees completed">
                                            <i class="fas fa-check-double"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span title="Part Payment" class="badge h3 bg-warning">
                                            <i class="fas fa-times-circle"></i> Part Payment
                                        </span>
                                    }
                                </td>
                                <td>@(item.Termregistration.SessionYear.Name)</td>
                                <td>@(item.Termregistration.Term)</td>
                                <td>@(item.Termregistration.Schoolclasses.Name + " - " + item.Termregistration.SubClasses.Name)</td>
                                <td>No Action</td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    </div>
</div>
<div class="modal bs-example-modal-center" id="paymentmodal" tabindex="-1" role="dialog" aria-labelledby="mySmallModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-secondary bg-opacity-50">
                <h5 class="modal-title mt-0">FEES PAYMENT DETAILS</h5>
                <button type="button" class="close" data-dismiss="modal" onclick="test();" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body alert-info bg-opacity-50">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Receipt Number</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="receipt" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Full Name</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="name" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Student Reg. No.</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="studentreg" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Session/Year</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="session" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Term</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="term" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Class</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="classes" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Fees To Pay</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="fees" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Amount Paid</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="amount" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Balance</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="balance" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Status</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="status" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Description</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="description" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Cashier's Name'</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="cash" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-2 row">
                            <label class="col-md-4">Recorded Date</label>
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-sm" id="create">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-secondary bg-opacity-50">
                <button type="button" class="btn btn-danger btn-sm" onclick="test();"  aria-label="Close">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" asp-for="IsSearch" />
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    @if (Model.IsSearch < 1)
    {
        <script src="~/js/feespayments.js" asp-append-version="true"></script>
    }
}