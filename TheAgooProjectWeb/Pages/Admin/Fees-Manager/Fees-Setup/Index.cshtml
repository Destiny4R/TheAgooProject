@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Fees_Setup.IndexModel
@{
    ViewData["Title"] = "Termly Fees List";
    ViewData["SubTitle"] = "Set and manage termly fees for classes";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}

<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash-coin me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Set and manage termly fees for classes</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus me-1"></i>&ensp; Add</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"].
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table class="table table-boredered table-striped table-striped-columns" id="termlyFeesdata">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Amount</th>
                        <th>Session/Year</th>
                        <th>Term</th>
                        <th>Class</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/termlyfees.min.js"></script>
}