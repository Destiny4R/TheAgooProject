@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Fees_Setup.UpsertModel
@{
    ViewData["Title"] = Model.termlyFees.Id > 0 ? "Update Termly Fees" : "Add Termly Fees";
}
<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge bg-dark"><h4 class="text-white">@(ViewData["Title"])</h4></div>
                <div>
                    <a class="btn btn-info btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
                </div>
            </div>
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger mt-2" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
                    <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"].
                </div>
            }
        </div>
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div class="p-2">
                        <div class="alert alert-primary"><h5 class="text-center">SET TERMLY FEES FOR CLASSES</h5></div>
                        <form class="form-horizontal" method="post" >
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group mb-2">
                                        <label for="username">Term</label>
                                        <select asp-for="termlyFees.Term" class="form-control form-control-sm">
                                            <option value="" disabled selected>---Select Term---</option>
                                            <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                                        </select>
                                        <span asp-validation-for="termlyFees.Term" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="">Session/Year</label>
                                        <select class="form-control form-control-sm" asp-for="termlyFees.SessionYearId" asp-items="Model.ViewSelectModel.SessionYearz">
                                            <option value="" disabled selected>---Select Session/Year---</option>
                                        </select>
                                        <span asp-validation-for="termlyFees.SessionYearId" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Class</label>
                                        <select class="form-control form-control-sm " asp-for="termlyFees.ClassesInSchoolId" asp-items="Model.ViewSelectModel.Class">
                                            <option value="" disabled selected>---Select Class---</option>
                                        </select>
                                        <span asp-validation-for="termlyFees.ClassesInSchoolId" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label>Amount</label>
                                        <input asp-for="termlyFees.Amount" class="form-control" />
                                        <span asp-validation-for="termlyFees.Amount" class="text-white badge bg-danger"></span>
                                    </div>
                                    <div class="mt-4">
                                        <button class="btn btn-primary btn-block waves-effect waves-light" type="submit">
                                            @(Model.termlyFees.Id > 0 ? "Update" : "Add fees")
                                        </button>
                                        <input type="hidden" asp-for="termlyFees.Id" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}