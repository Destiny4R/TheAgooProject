@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.PTA_Fees.PTA_Fees_AnalysisModel
@{
    ViewData["Title"] = "PTA Fees Analyses Page";
    ViewData["SubTitle"] = "Analyze expected PTA fees, income and debt";
    string[] Terms = { "First", "Second", "Third" };
    int tNoClass = 0;
    double TotalExpect = 0, TotalIncome = 0, Totaldebt = 0;
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-bar-chart-line me-2"></i> PTA Fees Analyses
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Analyze expected PTA fees, income and debt</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <div class="row">
                <div class="mt-3 col-sm-4">
                    <form method="post">
                        <div class="row mt-2">
                            <div class="col-12 input-group">
                                <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger col-8"></span>

                        </div>
                    </form>
                </div>
                <div class="mt-3 col-sm-8">
                    <form method="post">
                        <div class="row mt-2">
                            <div class="input-group">
                                <select asp-for="CTSSClass.Classes" class="form-control form-control-sm" required asp-items="Model.ViewSelectModel.Class">
                                    <option value="" disabled selected>---Select Class---</option>
                                </select>
                                <select class="form-control form-control-sm" required asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @if (Model.IsSearch > 0)
        {
            <div class="card-body">
                <div class=" d-flex justify-content-right mb-1">
                    <button class="btn btn-success" id="printbtn" type="button"><i class="far fa-file-excel"></i>&nbsp; Export File</button>
                </div>
                <table id="detailTable" class="table table-bordered table-striped mt-3 table-hover">
                    <thead class="table-dark bg-opacity-50">
                        <tr>
                            <th>Class</th>
                            <th>Term</th>
                            <th>No. in Class</th>
                            <th>Fees</th>
                            <th>Expected Fees</th>
                            <th>Income</th>
                            <th>Debt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TermReg.GroupBy(z => z.ClassesInSchoolId))
                        {
                            int f = 1, noinclassT = 0;
                            double expect = 0, incomeT = 0, debtT = 0;
                            foreach (var item2 in Terms)
                            {
                                var item3 = item.Where(m => m.Term == item2).ToList();
                                <tr>
                                    @if (f == 1)
                                    {
                                        <td rowspan="3">@(item3.FirstOrDefault().Schoolclasses.Name)</td>
                                    }
                                    <td>@(item2)</td>
                                    <td>
                                        @{
                                            var noinclass = Model.TermReg?.Where(k => k.Term == item2 && item3.FirstOrDefault()?.ClassesInSchoolId == k.ClassesInSchoolId)?.Count() ?? 0;
                                            noinclassT += noinclass;
                                            tNoClass += noinclass;
                                        } @(noinclass)
                                    </td>
                                    <td class="getfontname">
                                        @{
                                            var fees = Model.PaymentReports?.FirstOrDefault(k => k.Termregistration.Term == item2 && k.Termregistration.ClassesInSchoolId == item3.FirstOrDefault()?.ClassesInSchoolId)?.PTAFees.Fees ?? 0;
                                        }@(SD.ToNaira(fees))
                                    </td>
                                    <td class="getfontname">
                                        @{
                                            var getall = fees * noinclass;
                                            expect += getall;
                                            TotalExpect += getall;
                                        }
                                        @(SD.ToNaira(getall))
                                    </td>
                                    <td class="getfontname table-success bg-opacity-50">
                                        @{
                                            double amount = 0;
                                            var Paymentx = Model.PaymentReports?.Where(k => k.Termregistration.Term == item2 && k.Termregistration.ClassesInSchoolId == item3.FirstOrDefault()?.ClassesInSchoolId);
                                            foreach (var cummu in Paymentx)
                                            {
                                                amount += cummu.CulmulativePay;
                                            }
                                            TotalIncome += amount;
                                            incomeT += amount;
                                        }@(SD.ToNaira(amount))
                                    </td>
                                    <td class="getfontname table-warning">
                                        @{
                                            var debtx = (fees * noinclass) - amount;
                                            debtT += debtx;
                                            Totaldebt += debtx;
                                        }
                                        @(SD.ToNaira(debtx))
                                    </td>
                                </tr>
                                f++;
                            }
                            <tr class="table-info">
                                <td colspan="2">Total</td>
                                <td>@(noinclassT)</td>
                                <td>==</td>
                                <td class="lineup">@(SD.ToNaira(expect))</td>
                                <td class="lineup">@(SD.ToNaira(incomeT))</td>
                                <td class="lineup">@(SD.ToNaira(debtT))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-success">
                        <tr>
                            <td colspan="2"><strong>Grand Summary Total</strong></td>
                            <td>@(tNoClass)</td>
                            <td>==</td>
                            <td class="lineup"><strong>@(SD.ToNaira(TotalExpect))</strong></td>
                            <td class="lineup"><strong>@(SD.ToNaira(TotalIncome))</strong></td>
                            <td class="lineup"><strong>@(SD.ToNaira(Totaldebt))</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/jquery.table2excel.js"></script>
    <script>
        $(function () {
            $("#detailTable").find('#printbtn').on('click', function () {
                $.print("#detailTable");
            });
            $("#printbtn").click(function (e) {
                $("#detailTable").table2excel({
                    name: "Worksheet Name",
                    filename: 'Fees_Report_Sheet',
                    fileext: ".xlsx",
                    preserveColors: true
                });
            });
        });
    </script>
}
