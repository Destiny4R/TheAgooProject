@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.PTA_Fees.IndexModel
@{
    ViewData["Title"] = "PTA Payment List";
    ViewData["SubTitle"] = "Track PTA fees payments from students";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash me-2"></i> PTA Payment List
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Track PTA fees payments from students</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Make-Payment"><i class="bi bi-plus-square me-1"></i>&ensp; Add PTA Payment</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="studentdata" class="table table-bordered table-striped table-sm">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Name</th>
                        <th>Student Reg No.</th>
                        <th>PTA Fees</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Term</th>
                        <th>Session/Year</th>
                        <th>Class</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/pTAFeesPayment.js"></script>
}