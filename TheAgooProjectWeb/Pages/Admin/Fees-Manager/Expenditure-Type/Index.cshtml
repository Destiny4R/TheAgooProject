@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Expenditure_Type.IndexModel
@{
    ViewData["Title"] = "Expenditure Title List";
    ViewData["SubTitle"] = "Manage expenditure titles";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash-coin me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Upsert"><i class="bi bi-plus me-1"></i> Add Title</a>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <table id="expendi_Type" class="table table-boredered table-striped table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Description</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>

    <script src="~/js/expenditureType.js" asp-append-version="true"></script>

}
