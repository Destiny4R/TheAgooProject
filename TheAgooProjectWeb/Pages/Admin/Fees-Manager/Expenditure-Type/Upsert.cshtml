@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.Expenditure_Type.UpsertModel
@{
    ViewData["Title"] = Model.expenditure?.Id > 0 ? "Update Expenditure Title" : "Add Expenditure Title";
    ViewData["SubTitle"] = "Add or update an expenditure title";
    var btnname = Model.expenditure?.Id > 0 ? "Update" : "Record";
}

<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-cash-coin me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group row">
                            <label class="pl-3">Expenditure Type</label>
                            <div class="col-md-8">
                                <input class="form-control" asp-for="expenditure.Name" />
                                <span asp-validation-for="expenditure.Name" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8 mt-2">
                        <div class="">
                            <button type="submit" class="btn btn-primary">@(btnname)</button>
                            <input asp-for="expenditure.Id" type="hidden" />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}