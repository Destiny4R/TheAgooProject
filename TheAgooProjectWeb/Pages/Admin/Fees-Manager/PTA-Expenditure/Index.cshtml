@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.PTA_Expenditure.IndexModel
@{
    ViewData["Title"] = "PTA Expenditures List";
    ViewData["SubTitle"] = "Record and manage PTA expenditures";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-journal-arrow-down me-2"></i> PTA Expenditures List
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Record and manage PTA expenditures</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-light btn-sm" asp-page="Analyses"><i class="bi bi-bar-chart-line me-1"></i>&ensp; PTA Analyses</a>
            <a class="btn btn-outline-light btn-sm" asp-page="Upsert"><i class="bi bi-plus me-1"></i>&ensp; Add PTA Expenses</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="expenses" class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Report By</th>
                        <th>Amount</th>
                        <th>Term</th>
                        <th>Session/Year</th>
                        <th>Expenditure Type</th>
                        <th>Expenditure Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>

    <script src="~/js/pTAexpendituredata.js" asp-append-version="true"></script>

}
