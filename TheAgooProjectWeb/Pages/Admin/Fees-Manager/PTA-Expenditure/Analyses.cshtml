@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.PTA_Expenditure.AnalysesModel
@{
    ViewData["Title"] = "PTA Expenditures Analyses";
    int sn = 0;
}
<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge bg-dark"><h4 class="text-white">PTA Expenditures Analyses</h4></div>

                <div>
                    <a class="btn btn-info btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
                </div>
            </div>

            <div class="row">
                <div class="mt-3 col-sm-4">
                    <form method="post">
                        <div class="row mt-2">
                            <div class="col-12 input-group">
                                <select class="form-control form-control-sm" asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-success btn-sm" type="submit"><i class="fa fa-search"></i></button>
                                </div>
                            </div>
                            <span asp-validation-for="CTSSClass.SessionYear" class="text-white field-validation-valid badge badge-danger col-8"></span>

                        </div>
                    </form>
                </div>
                <div class="mt-3 col-sm-8">
                    <form method="post">
                        <div class="row mt-2">
                            <div class="input-group">
                                <select asp-for="CTSSClass.Term" class="form-control form-control-sm" required>
                                    <option value="" disabled selected>---Select Term---</option>
                                    <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                                </select>
                                <select class="form-control form-control-sm" required asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-success btn-sm" type="submit"><i class="fa fa-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @if (Model.IsSearch > 0)
        {
            <div class="card-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Term</th>
                            <th>Expenditure</th>
                            <th>Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.expenditures.GroupBy(m => m.Term))
                        {
                            var getcount = Model.expenditures.Where(k => k.Term == item.FirstOrDefault().Term).GroupBy(j => j.ExpedId).Count();
                            sn++; int h = 0, counter = 0;
                            double TotalTerm = 0;
                            foreach (var item2 in item.GroupBy(j => j.ExpedId))
                            {
                                counter++;
                                <tr>

                                    @if (h == 0)
                                    {
                                        <td rowspan="@(getcount)">@(sn)</td>
                                        <td rowspan="@(getcount)">@(item2.FirstOrDefault().Term)</td>
                                    }
                                    <td>@(item2.FirstOrDefault().ExpenditureType.Name)</td>
                                    <td>
                                        @{
                                            double moneyx = 0;
                                            foreach (var cost in item2)
                                            {
                                                moneyx += cost.Amount;
                                            }
                                            TotalTerm += moneyx;
                                        }
                                        @(SD.ToNaira(moneyx))
                                    </td>
                                </tr>
                                h++;
                            }
                            <tr>
                                <td colspan="3"><strong>Total</strong></td>
                                <td><strong>@(SD.ToNaira(TotalTerm))</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
