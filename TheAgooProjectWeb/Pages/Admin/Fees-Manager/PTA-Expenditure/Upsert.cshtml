@page
@model TheAgooProjectWeb.Pages.Admin.Fees_Manager.PTA_Expenditure.UpsertModel
@{
    ViewData["Title"] = Model.ExpenseVM?.Id > 0 ? "Update PTA Expenditure" : "Add PTA Expenditure";
    ViewData["SubTitle"] = "Add or update PTA expenditure records";
    var btnname = Model.ExpenseVM?.Id > 0 ? "Update" : "Record";
}
@section Sheets {
    <link href="~/lib/flatpickr/flatpickr.min.css" rel="stylesheet" />

}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-journal-arrow-down me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Add or update PTA expenditure records</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Total Amount</label>
                            <div class="">
                                <input class="form-select" asp-for="ExpenseVM.Amount" />
                                <span asp-validation-for="ExpenseVM.Amount" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Expenditure Type</label>
                            <div class="">
                                <select class="form-select" asp-for="ExpenseVM.ExpendId" asp-items="Model.ViewSelectModel.Class">
                                    <option value="" disabled selected>---Select Type---</option>
                                </select>
                                <span asp-validation-for="ExpenseVM.ExpendId" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <div class="form-group row">
                            <label class="pl-3">Term</label>
                            <div class="col-md-12">
                                <select asp-for="ExpenseVM.Term" class="form-select">
                                    <option value="" disabled selected>---Select Term---</option>
                                    <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                                </select>
                                <span asp-validation-for="ExpenseVM.Term" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group row">
                            <label class="pl-3">Transaction Date</label>
                            <div class="col-md-12">
                                <input class="form-select" asp-for="ExpenseVM.TransactionDate" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group row">
                            <label class="pl-3">Session/Year</label>
                            <div class="col-md-12">
                                <select class="form-select" asp-for="ExpenseVM.SessionYearId" asp-items="Model.ViewSelectModel.SessionYearz">
                                    <option value="" disabled selected>---Select Session/Year---</option>
                                </select>
                                <span asp-validation-for="ExpenseVM.SessionYearId" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-12">
                        <label>Expenditure details</label>
                        <textarea id="editor" asp-for="ExpenseVM.Description"></textarea>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-sm-12">
                        <button type="submit" class="btn btn-primary">@(btnname)</button>
                        <input asp-for="ExpenseVM.Id" type="hidden" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>

    <script src="~/assets/libs/tinymce/tinymce.min.js"></script>
    <script>
        $(document).ready(function () {
            0 < $("#editor").length && tinymce.init({
                selector: "textarea#editor",
                height: 300,
                plugins: ["advlist autolink link image lists charmap print preview hr anchor pagebreak spellchecker",
                    "searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking",
                    "save table contextmenu directionality emoticons template paste textcolor"],
                toolbar: "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | l      ink image | print preview media fullpage | forecolor backcolor emoticons",
                style_formats: [{ title: "Bold text", inline: "b" },
                {
                    title: "Red text", inline: "span",
                    styles: { color: "#ff0000" }
                },
                {
                    title: "Red header", block: "h1",
                    styles: { color: "#ff0000" }
                },
                {
                    title: "Example 1", inline: "span",
                    classes: "example1"
                },
                { title: "Example 2", inline: "span", classes: "example2" },
                { title: "Table styles" },
                { title: "Table row 1", selector: "tr", classes: "tablerow1" }]
            });

            flatpickr("#ExpenseVM_TransactionDate", {
                enableTime: false,
                dateFormat: "Y-m-d",
            });
        });
    </script>
}
