@page
@model TheAgooProjectWeb.Pages.Admin.ManageClass.IndexModel
@{
    ViewData["Title"] = "Class List";
    ViewData["SubTitle"] = "Manage school classes and types";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-diagram-3 me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#addClassModal"><i class="bi bi-pencil-square"></i>&nbsp; Add Class</button>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="classtable" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Class Name</th>
                        <th>Class Type</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addClassModal" tabindex="-1" aria-labelledby="addClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="addClassModalLabel"><i class="bi bi-diagram-3 me-2"></i>Add New Class</h1>
                    <small>Manage new class information</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="_class.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="_class.Name" required />
                        <span asp-validation-for="_class.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-2">
                        <h6 class="mb-2">Class Result Type</h6>
                        <div class="custom-control custom-radio mb-2">
                            <input type="radio" id="addClassElective" name="customRadio" class="custom-control-input" value="Cando">
                            <label class="custom-control-label" for="addClassElective">Elective Class</label>
                        </div>
                        <div class="custom-control custom-radio">
                            <input type="radio" id="addClassNonElective" name="customRadio" class="custom-control-input" value="Cannot" checked>
                            <label class="custom-control-label" for="addClassNonElective">Non-Elective Class</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                <input type="hidden" asp-for="_class.Id" />
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editClassModal" tabindex="-1" aria-labelledby="editClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="editClassModalLabel"><i class="bi bi-diagram-3 me-2"></i>Edit Class</h1>
                    <small>Manage class information</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="_class.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="_class.Name" required />
                        <span asp-validation-for="_class.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-2">
                        <h6 class="mb-2">Class Result Type</h6>
                        <div class="custom-control custom-radio mb-2">
                            <input type="radio" id="editClassElective" name="customRadio" class="custom-control-input" value="Cando">
                            <label class="custom-control-label" for="editClassElective">Elective Class</label>
                        </div>
                        <div class="custom-control custom-radio">
                            <input type="radio" id="editClassNonElective" name="customRadio" class="custom-control-input" value="Cannot">
                            <label class="custom-control-label" for="editClassNonElective">Non-Elective Class</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
                <input type="hidden" asp-for="_class.Id" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/class.js" asp-append-version="true"></script>
}
