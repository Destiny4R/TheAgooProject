@page
@model TheAgooProjectWeb.Pages.Admin.manageOtherPay.IndexModel
@{
    ViewData["Title"] = "Other Payment";
    ViewData["SubTitle"] = "Manage other payment types";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-wallet2 me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Upsert" class="btn btn-light btn-sm"><i class="bi bi-plus me-1"></i> Add Pay Type</a>
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong><i class="fas fa-info-circle"></i> </strong> @TempData["success"].
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="otherpay" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th> Other Pay Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/otherpay.js"></script>
}