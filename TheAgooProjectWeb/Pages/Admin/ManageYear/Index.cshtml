@page
@model TheAgooProjectWeb.Pages.Admin.ManageYear.IndexModel
@{
    ViewData["Title"] = "Session/Year List";
    ViewData["SubTitle"] = "Manage academic sessions and years";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-calendar3 me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">@ViewData["SubTitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addSessionModal">
                <i class="fas fa-plus me-2"></i> Add Session
            </button>
            @* <a asp-page="Upsert" class="btn btn-light btn-sm"><i class="bi bi-plus me-1"></i> Add Session</a> *@
        </div>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="sessiontable" class="table table-sm table-boredered table-hover table-stripped" width="100%">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th> Session/Year</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!--Add Session Modal -->
<div class="modal fade" id="addSessionModal" tabindex="-1" aria-labelledby="addSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="addSessionModalLabel"><i class="bi bi-calendar3 me-2"></i>Add New Session</h1>
                    <small>Manage new Session infomation</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="sessionYear.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="sessionYear.Name" required />
                        <span asp-validation-for="sessionYear.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Edit Session Modal -->
<div class="modal fade" id="editSessionModal" tabindex="-1" aria-labelledby="editSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h1 class="modal-title fs-5" id="editSessionModalLabel"><i class="bi bi-calendar3 me-2"></i>Edit Session</h1>
                    <small>Manage Session infomation</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="sessionYear.Name" class="form-label"></label>
                        <input type="text" class="form-control" asp-for="sessionYear.Name" required />
                        <span asp-validation-for="sessionYear.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
                <input type="hidden" asp-for="sessionYear.Id" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/session.js" asp-append-version="true"></script>
}