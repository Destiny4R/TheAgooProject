@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    int year = DateTime.UtcNow.Year;

}

<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Dashboard</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Aggo College Makurdi</a></li>
                            <li class="breadcrumb-item active">Dashboard</li>
                        </ol>
                    </div>

                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-sm-6 col-xl-3">
                <div class="card">
                    <div class="card-body">
                        <div class="media">
                            <div class="media-body">
                                <h5 class="font-size-14">Website Visits</h5>
                            </div>
                            <div class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-primary">
                                    <i class="dripicons-meter"></i>
                                </span>
                            </div>
                        </div>
                        <h4 class="m-0 align-self-center">@(Model.webvisit?.Website??0)</h4>
                        <p class="mb-0 mt-3 text-muted"><span class="text-success">@(DateTime.Now.ToShortDateString()) <i class="mdi mdi-trending-up mr-1"></i></span> As At Today</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card">
                    <div class="card-body">
                        <div class="media">
                            <div class="media-body">
                                <h5 class="font-size-14">Student Portal Visits</h5>
                            </div>
                            <div class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-primary">
                                    <i class="dripicons-meter"></i>
                                </span>
                            </div>
                        </div>
                        <h4 class="m-0 align-self-center">@(Model.webvisit?.Portal??0)</h4>
                        <p class="mb-0 mt-3 text-muted"><span class="text-success">@(DateTime.Now.ToShortDateString()) </span> As At Today</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card">
                    <div class="card-body">
                        <div class="media">
                            <div class="media-body">
                                <h5 class="font-size-14">SMS Credit</h5>
                            </div>
                            <div class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-primary">
                                    <i class="dripicons-message"></i>
                                </span>
                            </div>
                        </div>
                        <h4 id="balpro2" class="m-0 align-self-center">
                            
                        </h4>
                        <p class="mb-0 mt-3 text-muted"><span class="text-danger">@(DateTime.Now.ToShortDateString()) </span> As At Today</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card">
                    <div class="card-body">
                        <div class="media">
                            <div class="media-body">
                                <h5 class="font-size-14">Feedback Messages</h5>
                            </div>
                            <div class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-primary">
                                    <i class="dripicons-mail"></i>
                                </span>
                            </div>
                        </div>
                        <h4 class="m-0 align-self-center">@(Model.feedback)</h4>
                        <p class="mb-0 mt-3 text-muted"><span class="text-success">@(DateTime.Now.ToShortDateString()) </span> As At Today</p>
                    </div>
                </div>
            </div>

        </div>
        <!-- end row -->

        <div class="row">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">
                        <h4 class="header-title mb-3">Yearly Number of Admitted Students</h4>
                        <div id="flot-bar-1" style="height: 320px"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body">
                        <h4 class="header-title mb-4">Expected Profit, Income and Debt</h4>

                        <div id="column_chart" class="apex-charts" dir="ltr"></div>
                    </div>
                </div><!--end card-->
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <div class="card m-b-30">
                    <div class="card-body">
                        <h5 class="header-title pb-3">Revenue and Expenditure</h5>           
                        <div class="panel-body">
                            <canvas id="lineChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-12">
                <div class="card m-b-30">
                    <div class="card-body">
                        <h5 class="header-title pb-3">PTA Income and PTA Expenditures</h5>           
                        <div class="panel-body">
                            <canvas id="barChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div> 
</div>
@section Scripts {
    <script src="/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="/assets/libs/flot-charts/jquery.flot.js"></script>
    <script src="/assets/libs/flot-spline/js/jquery.flot.spline.min.js"></script>
    <script src="/assets/libs/morris.js/morris.min.js"></script>
    <script src="/assets/libs/raphael/raphael.min.js"></script>
    <script src="/assets/libs/jquery.flot.tooltip/js/jquery.flot.tooltip.min.js"></script>
    <script src="~/assets/libs/chart.js/chart.bundle.min.js"></script>
    <script>
        $(function () {
            "use strict";
            if ($("#flot-bar-1").length) {
                var data = [[@(year - 7), @(Model._Annual((year - 7), Model.students))], [@(year - 6), @(Model._Annual((year - 6), Model.students))], [@(year - 5), @(Model._Annual((year - 5), Model.students))], [@(year - 4), @(Model._Annual((year - 4), Model.students))], [@(year - 3), @(Model._Annual((year - 3), Model.students))], [@(year - 2), @(Model._Annual((year - 2), Model.students))], [@(year - 1), @(Model._Annual((year - 1), Model.students))], [@(year), @(Model._Annual((year), Model.students))], [@(year + 1), @(Model._Annual((year + 1), Model.students))]];

                $.plot($("#flot-bar-1"), [{
                    data: data
                }], {
                    series: {
                        bars: {
                            show: true,
                            lineWidth: 0,
                            barWidth: 0.3,
                            fillColor: "#0db4d6"
                        }
                    },
                    grid: {
                        borderWidth: 1,
                        borderColor: "rgba(123, 145, 158,0.1)",
                        labelMargin: 15,
                        hoverable: true // Enable hover
                    },
                    yaxis: {
                        tickColor: "rgba(123, 145, 158,0.1)",
                        font: {
                            color: "#7b919e",
                            size: 10
                        }
                    },
                    xaxis: {
                        tickColor: "rgba(123, 145, 158,0.1)",
                        font: {
                            color: "#7b919e",
                            size: 10
                        }
                    },
                    tooltip: true,
                    tooltipOpts: {
                        content: "%s : %y.0",
                        shifts: {
                            x: -30,
                            y: -50
                        }
                    }
                });
            }

            if ($("#column_chart").length) {
            var options = {
                chart: {
                    height: 350,
                    type: "bar",
                    toolbar: {
                        show: false
                    }
                },
                plotOptions: {
                    bar: {
                        horizontal: false,
                        columnWidth: "45%",
                        endingShape: "rounded"
                    }
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 2,
                    colors: ["transparent"]
                },
                series: [
                    {
                        name: "Expected Profit",
                                data: [@(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 8), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 7), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 6), Model.Registration)),
                                    @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 5), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 4), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 3), Model.Registration)),
                                    @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 2), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 1), Model.Registration)), @(Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 0), Model.Registration))]
                    },
                    {
                        name: "Income",
                        data: [@(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,8),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,7),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,6),Model.PaymentReports)),
                            @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,5),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,4),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,3),Model.PaymentReports)),
                            @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,2),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,1),Model.PaymentReports)), @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,0),Model.PaymentReports))]
                    },
                    {
                        name: "Debts",
                        data: [@((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 8), Model.Registration)-Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,8),Model.PaymentReports))), 
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 7), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,7),Model.PaymentReports))), 
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 6), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,6),Model.PaymentReports))),
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 5), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,5),Model.PaymentReports))), 
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 4), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,4),Model.PaymentReports))), 
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 3), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,3),Model.PaymentReports))),
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 2), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,2),Model.PaymentReports))), 
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 1), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,1),Model.PaymentReports))),
                                @((Model.FeesExpected(SD.GetValueAtIndex(Model._theSession, 0), Model.Registration) - Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,0),Model.PaymentReports)))]
                    }
                ],
                colors: ["#194D04", "#3d8ef8", "#11c46e"],
                xaxis: {
                        categories: [`@(SD.GetValueAtIndex(Model._theSession, 7))`, `@(SD.GetValueAtIndex(Model._theSession, 6))`, `@(SD.GetValueAtIndex(Model._theSession, 5))`,
                                    `@(SD.GetValueAtIndex(Model._theSession, 4))`, ` @(SD.GetValueAtIndex(Model._theSession, 3))`,
                                    ` @(SD.GetValueAtIndex(Model._theSession, 2))`, ` @(SD.GetValueAtIndex(Model._theSession, 1))`, ` @(SD.GetValueAtIndex(Model._theSession, 0))`]
                },
                yaxis: {
                    title: {
                            text: "₦ (thousands)"
                    }
                },
                grid: {
                    borderColor: "#f1f1f1"
                },
                fill: {
                    opacity: 1
                },
                tooltip: {
                    y: {
                        formatter: function (val) {
                                return "₦ " + val + " thousands";
                        }
                    }
                }
            };
            (chart = new ApexCharts(document.querySelector("#column_chart"), options)).render();
         }

            //line chart
                var ctx=document.getElementById( "lineChart");
                ctx.height=220;
                var myChart=new Chart( ctx, {
                    type: 'line', data: {
                        labels: [`@(SD.GetValueAtIndex(Model._theSession, 6))`,`@(SD.GetValueAtIndex(Model._theSession, 5))`,
                            `@(SD.GetValueAtIndex(Model._theSession, 4))`,`@(SD.GetValueAtIndex(Model._theSession, 3))`,`@(SD.GetValueAtIndex(Model._theSession, 2))`,
                            `@(SD.GetValueAtIndex(Model._theSession, 1))`,`@(SD.GetValueAtIndex(Model._theSession, 0))`], datasets: [ {
                            label: "Income", borderColor: "rgba(49, 119, 13, 0.85)", 
                            borderWidth: "1", backgroundColor: "rgba(49, 119, 13, 0.85)",
                            data: [ @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,6),Model.PaymentReports)),@(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,5),Model.PaymentReports)),
                                @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,4),Model.PaymentReports)),@(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,3),Model.PaymentReports)),@(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,2),Model.PaymentReports)),@(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,1),Model.PaymentReports)),
                                @(Model.FeesIncome(SD.GetValueAtIndex(Model._theSession,0),Model.PaymentReports))]
                        }
                        , {
                            label: "Expenditures", borderColor: "rgba(152, 7, 95, 0.75)", 
                            borderWidth: "1", backgroundColor: "rgba(152, 7, 95, 0.75)", pointHighlightStroke: "rgba(26,179,148,1)", 
                            data: [ @(Model.Expenses(SD.GetValueAtIndex(Model._theSession,6),Model.Expenditures)),@(Model.Expenses(SD.GetValueAtIndex(Model._theSession,5),Model.Expenditures)),
                                @(Model.Expenses(SD.GetValueAtIndex(Model._theSession,4),Model.Expenditures)),@(Model.Expenses(SD.GetValueAtIndex(Model._theSession,3),Model.Expenditures)),@(Model.Expenses(SD.GetValueAtIndex(Model._theSession,2),Model.Expenditures)),@(Model.Expenses(SD.GetValueAtIndex(Model._theSession,1),Model.Expenditures)),
                                @(Model.Expenses(SD.GetValueAtIndex(Model._theSession,0),Model.Expenditures))]
                        }
                        ]
                    }
                    , options: {
                        responsive: true, tooltips: {
                            mode: 'index', intersect: false
                        }
                        , hover: {
                            mode: 'nearest', intersect: true
                        }
                    }
                }
                );



            //bar chart
    var ctx=document.getElementById( "barChart");
    ctx.height=220;
    var myChart=new Chart( ctx, {
        type: 'bar', data: {
                labels: [ `@(SD.GetValueAtIndex(Model._theSession, 6))`,`@(SD.GetValueAtIndex(Model._theSession, 5))`,
                                `@(SD.GetValueAtIndex(Model._theSession, 4))`,`@(SD.GetValueAtIndex(Model._theSession, 3))`,`@(SD.GetValueAtIndex(Model._theSession, 2))`,
                                `@(SD.GetValueAtIndex(Model._theSession, 1))`,`@(SD.GetValueAtIndex(Model._theSession, 0))`], datasets: [ {
                    label: "PTA Income", data: [ @(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,6),Model.pTAFeesReports)),@(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,5),Model.pTAFeesReports)),
                                                @(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,4),Model.pTAFeesReports)),@(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,3),Model.pTAFeesReports)),@(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,2),Model.pTAFeesReports)),@(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,1),Model.pTAFeesReports)),
                                                @(Model.PTAFeesIncome(SD.GetValueAtIndex(Model._theSession,0),Model.pTAFeesReports))], borderColor: "rgba(8, 91, 45, 0.75)", borderWidth: "0", backgroundColor: "rgba(8, 91, 45, 0.75)"
            }
            , {
                label: "PTA Expenditures", data: [@(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,6),Model.pTAExpenditures)),@(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,5),Model.pTAExpenditures)),
                                                @(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,4),Model.pTAExpenditures)),@(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,3),Model.pTAExpenditures)),@(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,2),Model.pTAExpenditures)),@(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,1),Model.pTAExpenditures)),
                                                @(Model.PTAExpenses(SD.GetValueAtIndex(Model._theSession,0),Model.pTAExpenditures))], borderColor: "rgba(146, 4, 41, 0.75)", borderWidth: "0", backgroundColor: "rgba(146, 4, 41, 0.75)"
            }
            ]
        }
        , options: {
            scales: {
                yAxes: [ {
                    ticks: {
                        beginAtZero: true
                    }
                }
                ]
            }
        }
    }
    );


            
       
        });
    </script>
}