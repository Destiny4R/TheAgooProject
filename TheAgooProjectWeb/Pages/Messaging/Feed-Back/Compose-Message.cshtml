@page
@model TheAgooProjectWeb.Pages.Messaging.Feed_Back.Compose_MessageModel
@{
    ViewData["Title"] = "Send and reply emails";
    ViewData["SubTitle"] = "Compose and send new emails or replies";
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-pencil-square me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Compose and send new emails or replies</div>
        </div>
        <a class="btn btn-light btn-sm tms-back" asp-page="Index">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-2" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
            <strong><i class="fa fa-warning"></i></strong> @TempData["error"].
        </div>
    }
    <div class="card mt-3">
        <div class="card-body">
            <form method="post">
                <div class="form-group row">
                    <label class="col-sm-4">Sender:</label>
                    <div class="col-sm-8">
                        <input type="text" asp-for="Message.Sender" class="form-control form-control-sm" readonly />
                        <span asp-validation-for="Message.Sender" class="text-white badge bg-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4">Send To:</label>
                    <div class="col-sm-8">
                        <input type="text" asp-for="Message.SendTo" class="form-control form-control-sm" />
                        <span asp-validation-for="Message.SendTo" class="text-white badge bg-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4">CC</label>
                    <div class="col-sm-8">
                        <input type="text" data-val="false" asp-for="Message.CarbonCopy" class="form-control form-control-sm" placeholder="seperate with commas e.g. japheth@gmail.com,mike@gmail.com" />
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4">Subject</label>
                    <div class="col-sm-8">
                        <input type="text" asp-for="Message.Subject" class="form-control form-control-sm" />
                        <span asp-validation-for="Message.Subject" class="text-white badge bg-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Message Body</label>
                            <textarea id="editor" asp-for="Message.Message" class=""></textarea>
                            <span asp-validation-for="Message.Message" class="text-white badge bg-danger"></span>
                        </div>
                    </div>
                </div>
                <div>
                    <button class="btn btn-primary float-end" type="submit"><i class="far fa-paper-plane"></i> Send</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/tinymce/tinymce.min.js"></script>
    <script>
        $(document).ready(function () {
            0 < $("#editor").length && tinymce.init({
                selector: "textarea#editor",
                height: 350,
                plugins: ["advlist autolink link image lists charmap print preview hr anchor pagebreak spellchecker",
                    "searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking",
                    "save table contextmenu directionality emoticons template paste textcolor"],
                toolbar: "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | l      ink image | print preview media fullpage | forecolor backcolor emoticons",
                style_formats: [{ title: "Bold text", inline: "b" },
                {
                    title: "Red text", inline: "span",
                    styles: { color: "#ff0000" }
                },
                {
                    title: "Red header", block: "h1",
                    styles: { color: "#ff0000" }
                },
                {
                    title: "Example 1", inline: "span",
                    classes: "example1"
                },
                { title: "Example 2", inline: "span", classes: "example2" },
                { title: "Table styles" },
                { title: "Table row 1", selector: "tr", classes: "tablerow1" }]
            });
        });
    </script>
}
