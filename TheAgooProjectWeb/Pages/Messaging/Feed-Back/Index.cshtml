@page
@model TheAgooProjectWeb.Pages.Messaging.Feed_Back.IndexModel
@{
    ViewData["Title"] = "Feed Back Messages";
    ViewData["SubTitle"] = "View and manage messages received from visitors";
}
@section Sheets{
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-chat-dots me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">View and manage messages received from visitors</div>
        </div>
        <a class="btn btn-light btn-sm" asp-page="Compose-Message">
            <i class="bi bi-envelope-paper me-1"></i>
            Compose email
        </a>
    </div>
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card mt-3">
        <div class="card-body">
            <table id="tablenews" width="100%" class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Date Send</th>
                        <th>Read/Unread</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/feedback.js" asp-append-version="true"></script>
}