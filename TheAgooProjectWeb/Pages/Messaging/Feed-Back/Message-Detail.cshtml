@page
@model TheAgooProjectWeb.Pages.Messaging.Feed_Back.Message_DetailModel
@{
    ViewData["Title"] = "Feed Back From: " + Model.feedBack.Subject;
}
<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge bg-dark"><strong class="h4 text-white">Feed back message detail</strong></div>
                <div><a class="btn btn-info btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a></div>
            </div>
        </div>
        <div class="card-body">
            <div class="container">
                <div class="form-group row">
                    <label asp-for="feedBack.Name" class="font-weight-bold text-dark text-2"></label>
                    <input asp-for="feedBack.Name" class="form-control" readonly disabled />
                </div>
                <div class="form-group row mt-3">
                    <label asp-for="feedBack.Email" class="font-weight-bold text-dark text-2"></label>
                    <input asp-for="feedBack.Email" class="form-control" readonly disabled />
                </div>
                <div class="form-group row mt-3">
                    <label asp-for="feedBack.Subject" class="font-weight-bold text-dark text-2"></label>
                    <input asp-for="feedBack.Subject" class="form-control" readonly disabled />
                </div>
                <div class="form-group row mt-3">
                    <label asp-for="feedBack.Message" class="font-weight-bold text-dark text-2"></label>
                    <p class="">@Model.feedBack.Message</p>
                </div>
                <div>
                    <a class="float-end btn btn-success btn-sm" asp-page="Compose-Message" asp-route-id="@Model.feedBack.Id"><i class="fa fa-reply"></i> reply</a>
                </div>
            </div>
        </div>
    </div>
</div>
