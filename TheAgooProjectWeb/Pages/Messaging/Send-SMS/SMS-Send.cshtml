@page
@model TheAgooProjectWeb.Pages.Messaging.Send_SMS.SMS_SendModel
@{
    ViewData["Title"] = "Send SMS";
}

<div class="page-content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <div class="badge bg-dark"><h4 class="text-white">Send SMS</h4></div>

                <div class="">
                    <a class="btn btn-info btn-sm" asp-page="Index"><i class="fa fa-arrow-left"></i>&ensp; Back</a>
                </div>
            </div>
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger mt-2" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
                    <strong><i class="fas fa-exclamation-triangle"></i></strong> @TempData["error"]
                </div>
            }

            <div class="mt-3 ">
                <form method="post" asp-page-handler="Search">
                    <div class="row mt-2">
                        <div class="input-group">
                            <select asp-for="CTSSClass.Term" class="form-control form-control-sm" required>
                                <option value="" disabled selected>---Select Term---</option>
                                <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                            </select>
                            <select class="form-control form-control-sm" required asp-for="CTSSClass.SessionYear" asp-items="Model.ViewSelectModel.SessionYearz">
                                <option value="" disabled selected>---Select Session/Year---</option>
                            </select>
                            <div class="input-group-append">
                                <button class="btn btn-success btn-sm" type="submit"><i class="fa fa-search"> Load Numbers</i></button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Send">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-md-4">Sender Title</label>
                            <div class="col-md-8">
                                <input class="form-control form-control-sm" asp-for="smsData.Sender" />
                                <span asp-validation-for="smsData.Sender" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-md-4">Subject</label>
                            <div class="col-md-8">
                                <input class="form-control form-control-sm" asp-for="smsData.Subject" />
                                <span asp-validation-for="smsData.Subject" class="text-white field-validation-valid badge badge-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <label class="col-md-4">Phone Number(s)</label>
                        <textarea class="form-control" rows="5" asp-for="smsData.PhoneNumber" placeholder="e.g 2348023569874,234806985742"></textarea>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <label class="col-md-4">Message Body</label>
                        <textarea class="form-control" rows="5" asp-for="smsData.Message" onkeyup="countincrement();" onpaste="countincrement();"></textarea>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-primary" type="submit"><i class="far fa-paper-plane"></i> Send</button>
                        <div>
                            <label id="smscharcount" class="text-dark">0</label>/160 &emsp;
                            <label id="smspage" class="text-dark"></label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/smslength.js"></script>
}