@page
@model TheAgooProjectWeb.Pages.Compute_Result.General_Class_Info.IndexModel
@{
    ViewData["Title"] = "Class General Info List";
    ViewData["SubTitle"] = "Manage general information for classes";
}
@section Sheets {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @await Html.PartialAsync("_DataTablesSheetFiles")
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-clipboard-check me-2"></i> General Class Info List
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Manage general information for classes</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Upsert" class="btn btn-light btn-sm"><i class="bi bi-plus-square me-1"></i>&nbsp; Add Info</a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-info-circle"></i></strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i></strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="general" class="table table-sm table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Term</th>
                            <th>Session/Year</th>
                            <th>Class</th>
                            <th>Sub-Class</th>
                            <th>Next Term Start</th>
                            <th>Next Term End</th>
                            <th>Class Teacher</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    @await Html.PartialAsync("_DataTablesScriptsFiles")
    <script src="~/lib/blockui/jquery.blockui.min.js"></script>
    <script src="~/js/generaltabledata.js" asp-append-version="true"></script>
}