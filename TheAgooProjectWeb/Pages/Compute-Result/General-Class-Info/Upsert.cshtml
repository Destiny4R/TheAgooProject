@page
@model TheAgooProjectWeb.Pages.Compute_Result.General_Class_Info.UpsertModel
@{
    ViewData["Title"] = Model.general?.Id > 0 ? "Update Class General Information" : "Add Class General Information";
    ViewData["SubTitle"] = "Add or update general information for a class";
    var name = Model.general?.Id > 0 ? "Update record" : "Submit record";
}
@section Sheets {
    <link href="~/lib/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="/assets/libs/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet">
}
<div class="page-content fade-in">
    <div class="tms-header mb-3">
        <div>
            <div class="tms-title">
                <i class="bi bi-journal-plus me-2"></i> @ViewData["Title"]
            </div>
            <div style="font-size:.82rem; opacity:.8; margin-top:2px;">Add or update general information for a class</div>
        </div>
        <a class="btn btn-light btn-sm tms-back" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>&ensp; Back</a>
    </div>
    <div class="card">
        <div class="card-body">               
            <form method="post" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-sm-3 mb-3">
                        <label for="validationCustom01">Term</label>
                        <select asp-for="general.Term" class="form-control">
                            <option value="" disabled selected>---Select Term---</option>
                            <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
                        </select>
                        <span asp-validation-for="general.Term" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <label for="validationCustom02">Session/Year</label>
                        <select class="form-control" asp-for="general.SessionYearId" asp-items="Model.ViewSelectModel.SessionYearz">
                            <option value="" disabled selected>---Select Session/Year---</option>
                        </select>
                        <span asp-validation-for="general.SessionYearId" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <label asp-for="general.ClassId"></label>
                        <select class="form-control" asp-for="general.ClassId" asp-items="Model.ViewSelectModel.Class">
                            <option value="" disabled selected>---Select Class---</option>
                        </select>
                        <span asp-validation-for="general.ClassId" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <label asp-for="general.SubClassId"></label>
                        <select class="form-control" asp-for="general.SubClassId" asp-items="Model.ViewSelectModel.SubClass">
                            <option value="" disabled selected>---Select Class---</option>
                        </select>
                        <span asp-validation-for="general.SubClassId" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.Next_Term_Fees"></label>
                        <input asp-for="general.Next_Term_Fees" class="form-control" required />
                        <span asp-validation-for="general.Next_Term_Fees" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.NextTermStart"></label>
                        <input type="text" class="form-control getdate" asp-for="general.NextTermStart" required />
                        <span asp-validation-for="general.NextTermStart" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.TermEnd"></label>
                        <input type="text" class="form-control getdate" asp-for="general.TermEnd" required />
                        <span asp-validation-for="general.TermEnd" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.TotalAttendance"></label>
                        <input type="text" class="form-control" asp-for="general.TotalAttendance" required />
                        <span asp-validation-for="general.TotalAttendance" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.ClassTeacher"></label>
                        <input type="text" class="form-control" asp-for="general.ClassTeacher" required />
                        <span asp-validation-for="general.ClassTeacher" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="general.PrincipalName"></label>
                        <input type="text" class="form-control" asp-for="general.PrincipalName" required />
                        <span asp-validation-for="general.PrincipalName" class="text-white field-validation-valid badge badge-danger valid-feedback"></span>
                    </div>
                </div>
                <input asp-for="general.Id" type="hidden" />
                <div class="p-2">
                    <button class="btn btn-primary" type="submit"> @(name)</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="/assets/libs/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script>
        flatpickr(".getdate", {
            enableTime: false,
            dateFormat: "Y-m-d",
        });
        // !function () { "use strict";
        //     flatpickr(".getdate", {
        //         enableTime: false,
        //         dateFormat: "Y-m-d",
        //     });
        //     flatpickr("#general_TermEnd", {
        //         enableTime: false,
        //         dateFormat: "Y-m-d",
        //     });
    </script>
}